@model ZEmpireAutoAccessories.Models.Quotation

@{
    ViewData["Title"] = "Quotation Details";
    var successMessage = TempData["Success"] as string;
    var convertError = TempData["ConvertError"] as string;
    var lockError = TempData["LockError"] as string;
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; margin-bottom:18px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .badge-draft { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
    .badge-sent { background:rgba(59,130,246,.15); color:#1d4ed8; font-weight:600; }
    .badge-accepted { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-rejected { background:rgba(239,68,68,.15); color:#b91c1c; font-weight:600; }
    .badge-posted { background:rgba(124,58,237,.15); color:#6d28d9; font-weight:600; }
    .totals-row td { font-weight:600; }
    .status-actions form { display:inline; margin-right:8px; }
    .btn-zx, .btn-outline-secondary { display:inline-flex; align-items:center; gap:7px; }
    .btn-pdf { display:inline-flex; align-items:center; gap:7px; background:#0b0b0c; border-color:#0b0b0c; color:#fff; font-weight:600; }
    .btn-pdf:hover { background:#262626; border-color:#262626; color:#fff; }
    .icon-btn { width:32px; height:32px; display:inline-grid; place-items:center; border-radius:8px; border:1px solid #e8ebf0;
                background:#fff; color:#4b5563; transition:all .15s ease; }
    .icon-btn.danger:hover { background:#dc2626; color:#fff; border-color:#dc2626; }
    #removeLineModal .modal-content, #convertModal .modal-content { border-radius:14px; border:none; }
    #removeLineModal .modal-title, #convertModal .modal-title { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:19px; }
</style>

<div class="zx-page-head">
    <h1>Quotation @Model.QuotationNumber</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.QuotationID">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            Edit
        </a>
        <a class="btn btn-pdf" asp-action="Pdf" asp-route-id="@Model.QuotationID" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            Generate PDF
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Back to list
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(convertError))
{
    <div class="alert alert-danger">@convertError</div>
}
@if (!string.IsNullOrEmpty(lockError))
{
    <div class="alert alert-danger">@lockError</div>
}

<div class="zx-card">
    <dl class="row mb-3">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.Customer.FullName</dd>

        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">@(Model.Vehicle.PlateNumber ?? "—") — @Model.Vehicle.Brand @Model.Vehicle.Model</dd>

        <dt class="col-sm-3">Job Type</dt>
        <dd class="col-sm-9">@(Model.JobType?.JobTypeName ?? "—")</dd>

        <dt class="col-sm-3">Quotation Date</dt>
        <dd class="col-sm-9">@Model.QuotationDate.ToString("MMM d, yyyy")</dd>

        <dt class="col-sm-3">Valid Until</dt>
        <dd class="col-sm-9">@(Model.ValidUntil?.ToString("MMM d, yyyy") ?? "—")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge badge-@Model.Status.ToLower()">@Model.Status</span>
            @if (Model.JobOrder != null)
            {
                <span class="badge badge-accepted">Converted to Job Order #@Model.JobOrder.JobOrderID</span>
            }
        </dd>

        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <dt class="col-sm-3">Remarks</dt>
            <dd class="col-sm-9">@Model.Remarks</dd>
        }
    </dl>

    <div class="status-actions">
        @if (Model.Status == "Draft")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.QuotationID" />
                <input type="hidden" name="status" value="Sent" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as Sent</button>
            </form>
        }
        @if (Model.Status == "Sent")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.QuotationID" />
                <input type="hidden" name="status" value="Accepted" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as Accepted</button>
            </form>
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.QuotationID" />
                <input type="hidden" name="status" value="Rejected" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as Rejected</button>
            </form>
        }
        @if (Model.Status == "Accepted" && Model.JobOrder == null)
        {
            <button type="button" class="btn btn-sm btn-zx" data-bs-toggle="modal" data-bs-target="#convertModal">
                Convert to Job Order
            </button>
        }
    </div>
</div>

<div class="zx-card">
    <h6 class="mb-3">Line Items</h6>
    <div class="table-responsive">
    <table class="table zx-table mb-3">
        <thead>
            <tr>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Sub Total</th>
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Details)
            {
                <tr>
                    <td>
                        @(line.Product?.ProductName ?? line.Service?.ServiceName ?? "—")
                        @if (line.TintVariant != null || line.Panel != null)
                        {
                            <div class="text-muted small">
                                @string.Join(" · ", new[] { line.TintVariant?.VariantName, line.Panel?.PanelName }.Where(s => !string.IsNullOrEmpty(s)))
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(line.Description))
                        {
                            <div class="text-muted small">@line.Description</div>
                        }
                    </td>
                    <td>@line.Quantity</td>
                    <td>@line.Unit</td>
                    <td>@("₱" + line.UnitPrice.ToString("N2"))</td>
                    <td>@("₱" + line.SubTotal.ToString("N2"))</td>
                    <td class="text-end pe-3">
                        <button type="button" class="icon-btn danger remove-line-btn" title="Remove line item"
                                data-bs-toggle="modal" data-bs-target="#removeLineModal"
                                data-detail-id="@line.QuotationDetailID"
                                data-detail-name="@(line.Product?.ProductName ?? line.Service?.ServiceName ?? "this line item")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </td>
                </tr>
            }
            @if (!Model.Details.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">No line items yet.</td>
                </tr>
            }
            <tr class="totals-row">
                <td colspan="4" class="text-end">Sub Total</td>
                <td colspan="2">@("₱" + Model.SubTotal.ToString("N2"))</td>
            </tr>
            <tr class="totals-row">
                <td colspan="4" class="text-end">Discount</td>
                <td colspan="2">@("₱" + Model.DiscountAmount.ToString("N2"))</td>
            </tr>
            <tr class="totals-row">
                <td colspan="4" class="text-end">Tax</td>
                <td colspan="2">@("₱" + Model.TaxAmount.ToString("N2"))</td>
            </tr>
            <tr class="totals-row">
                <td colspan="4" class="text-end">Total</td>
                <td colspan="2">@("₱" + Model.TotalAmount.ToString("N2"))</td>
            </tr>
        </tbody>
    </table>
    </div>

    <h6 class="mb-3">Add Line Item</h6>
        <form asp-action="AddLine" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="quotationId" value="@Model.QuotationID" />

            <div class="col-md-3">
                <label class="form-label">Product</label>
                <select id="addLineProduct" name="productId" class="form-select">
                    <option value="">-- None --</option>
                    @foreach (var p in (List<Product>)ViewData["Products"]!)
                    {
                        <option value="@p.ProductID" data-price="@((p.DefaultPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))">@p.ProductName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Service</label>
                <select id="addLineService" name="serviceId" class="form-select">
                    <option value="">-- None --</option>
                    @foreach (var s in (List<Service>)ViewData["Services"]!)
                    {
                        <option value="@s.ServiceID" data-price="@s.DefaultPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">@s.ServiceName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" title="Only applies to products with more than one tint variant (e.g. Play/Freeze/Max)">Tint Variant</label>
                <select id="addLineTintVariant" name="tintVariantId" class="form-select" disabled>
                    <option value="">-- N/A --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" title="Which part of the vehicle this line covers - determines the matrix price for this vehicle's classification">Panel</label>
                <select id="addLinePanel" name="panelId" class="form-select" disabled>
                    <option value="">-- N/A --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Description</label>
                <input type="text" name="description" class="form-control" placeholder="Optional" />
            </div>
            <div class="col-md-2">
                <label class="form-label" title="How many units of this product or service">Qty</label>
                <input type="number" name="quantity" class="form-control" value="1" min="1" />
            </div>
            <div class="col-md-2">
                <label class="form-label" title="Unit of measure shown on the printed document and invoice, e.g. pc, roll, set">Unit</label>
                <input type="text" name="unit" class="form-control" value="Unit" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Price</label>
                <input id="addLinePrice" type="number" step="0.01" name="unitPrice" class="form-control" value="0" min="0" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-zx w-100">Add</button>
            </div>
        </form>
        <div class="form-text mt-2">
            Pick either a Product or a Service for the line item. For products priced by panel, pick a Tint Variant
            (if applicable) and a Panel to pull the exact price for this vehicle's classification.
        </div>
</div>

<div class="modal fade" id="removeLineModal" tabindex="-1" aria-labelledby="removeLineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="RemoveLine" method="post" id="removeLineForm">
                <input type="hidden" name="detailId" id="removeLineDetailId" value="" />
                <input type="hidden" name="quotationId" value="@Model.QuotationID" />
                <div class="modal-header">
                    <h5 class="modal-title" id="removeLineModalLabel">Remove Line Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Remove <strong id="removeLineDetailName">this line item</strong> from this quotation? This can't be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Remove</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="convertModal" tabindex="-1" aria-labelledby="convertModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Convert" method="post">
                <input type="hidden" name="id" value="@Model.QuotationID" />
                <div class="modal-header">
                    <h5 class="modal-title" id="convertModalLabel">Convert to Job Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Convert quotation <strong>@Model.QuotationNumber</strong> to a job order? A new job order will be created from this quotation's line items. This can't be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-zx">Convert</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('removeLineModal');
            if (!modalEl) return;
            modalEl.addEventListener('show.bs.modal', function (event) {
                var btn = event.relatedTarget;
                document.getElementById('removeLineDetailId').value = btn.getAttribute('data-detail-id');
                document.getElementById('removeLineDetailName').textContent = btn.getAttribute('data-detail-name');
            });
        });

        // Fill in the Price field as soon as a product or service is picked
        // on the Add Line Item form (still editable afterward). For products
        // priced by the Pricing matrix (Product x Tint Variant x this
        // vehicle's classification x Panel), the Tint Variant/Panel pickers
        // drive the exact price instead of the product's flat DefaultPrice.
        // Picking a Product or Service clears the other, since a line is
        // either one or the other.
        (function () {
            var pricingMatrix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["PricingMatrix"]));
            var $product = $('#addLineProduct');
            var $service = $('#addLineService');
            var $tintVariant = $('#addLineTintVariant');
            var $panel = $('#addLinePanel');
            var $price = $('#addLinePrice');
            if (!$product.length || !$service.length || !$tintVariant.length || !$panel.length || !$price.length) { return; }

            function rowsForProduct(productId) {
                return pricingMatrix.filter(function (r) { return r.productId === productId; });
            }

            function resetSelect($select, placeholder) {
                $select.empty().append($('<option></option>').val('').text(placeholder)).prop('disabled', true);
            }

            function refreshPanels() {
                var productId = parseInt($product.val(), 10);
                var tintVariantId = $tintVariant.prop('disabled') ? null : ($tintVariant.val() || null);
                var rows = productId ? rowsForProduct(productId).filter(function (r) {
                    return String(r.tintVariantId || '') === String(tintVariantId || '');
                }) : [];

                if (rows.length === 0) {
                    resetSelect($panel, '-- N/A --');
                    return;
                }

                $panel.empty().append($('<option></option>').val('').text('-- Select Panel --')).prop('disabled', false);
                rows.forEach(function (r) {
                    $panel.append($('<option></option>').val(r.panelId).text(r.panelName).attr('data-price', r.price));
                });

                // Only one panel option for this product/variant - skip
                // making the user pick it themselves.
                if (rows.length === 1) {
                    $panel.val(rows[0].panelId);
                    $price.val(parseFloat(rows[0].price).toFixed(2));
                }
            }

            function refreshTintVariants() {
                var productId = parseInt($product.val(), 10);
                var rows = productId ? rowsForProduct(productId) : [];
                var variants = {};
                rows.forEach(function (r) {
                    if (r.tintVariantId != null) { variants[r.tintVariantId] = r.tintVariantName; }
                });
                var variantIds = Object.keys(variants);

                if (variantIds.length === 0) {
                    resetSelect($tintVariant, '-- N/A --');
                } else {
                    $tintVariant.empty().append($('<option></option>').val('').text('-- Select Variant --')).prop('disabled', false);
                    variantIds.forEach(function (id) {
                        $tintVariant.append($('<option></option>').val(id).text(variants[id]));
                    });

                    // Only one tint variant on file for this product - skip
                    // making the user pick it themselves.
                    if (variantIds.length === 1) {
                        $tintVariant.val(variantIds[0]);
                    }
                }

                refreshPanels();
            }

            // Guarded on $(this).val() being truthy: clearing the other field
            // sets its value to '', so its own handler sees a falsy val()
            // and skips straight past its "clear the other one" branch -
            // that's what stops this pair from bouncing back and forth.
            $product.on('change', function () {
                var productId = parseInt($(this).val(), 10) || 0;
                if (!productId) {
                    resetSelect($tintVariant, '-- N/A --');
                    resetSelect($panel, '-- N/A --');
                    return;
                }

                $service.val('').trigger('change');

                var rows = rowsForProduct(productId);
                if (rows.length === 0) {
                    // No matrix pricing for this product - fall back to its
                    // own flat default price, and there's nothing to pick.
                    resetSelect($tintVariant, '-- N/A --');
                    resetSelect($panel, '-- N/A --');
                    var flatPrice = $(this).find(':selected').data('price');
                    if (flatPrice !== undefined) { $price.val(parseFloat(flatPrice).toFixed(2)); }
                } else {
                    refreshTintVariants();
                }
            });

            $tintVariant.on('change', refreshPanels);

            $panel.on('change', function () {
                var price = $(this).find(':selected').data('price');
                if ($(this).val() && price !== undefined) {
                    $price.val(parseFloat(price).toFixed(2));
                }
            });

            $service.on('change', function () {
                if (!$(this).val()) { return; }

                var price = $(this).find(':selected').data('price');
                if (price !== undefined) { $price.val(parseFloat(price).toFixed(2)); }

                $product.val('').trigger('change');
                resetSelect($tintVariant, '-- N/A --');
                resetSelect($panel, '-- N/A --');
            });
        })();
    </script>
}
