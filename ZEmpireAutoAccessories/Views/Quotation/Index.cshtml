@model IEnumerable<ZEmpireAutoAccessories.Models.Quotation>

@{
    ViewData["Title"] = "Quotations";
    var status = ViewData["Status"] as string;
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .zx-actions a {
        margin-right: 10px;
        font-weight: 600;
        font-size: 13.5px;
    }

    .badge-draft {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }

    .badge-sent {
        background: rgba(59,130,246,.15);
        color: #1d4ed8;
        font-weight: 600;
    }

    .badge-accepted {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-rejected {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .status-filters a {
        margin-right: 8px;
        font-size: 13px;
    }
</style>

<div class="zx-page-head">
    <h1>Quotations</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Quotation</a>
</div>

<div class="status-filters mb-3">
    <a asp-action="Index" class="@(status == null ? "fw-bold" : "")">All</a>
    <a asp-action="Index" asp-route-status="Draft" class="@(status == "Draft" ? "fw-bold" : "")">Draft</a>
    <a asp-action="Index" asp-route-status="Sent" class="@(status == "Sent" ? "fw-bold" : "")">Sent</a>
    <a asp-action="Index" asp-route-status="Accepted" class="@(status == "Accepted" ? "fw-bold" : "")">Accepted</a>
    <a asp-action="Index" asp-route-status="Rejected" class="@(status == "Rejected" ? "fw-bold" : "")">Rejected</a>
</div>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Number</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.QuotationNumber</td>
                    <td>@item.Customer.FullName</td>
                    <td>@(item.Vehicle.PlateNumber ?? "—")</td>
                    <td>@item.QuotationDate.ToString("MMM d, yyyy")</td>
                    <td>@("₱" + item.TotalAmount.ToString("N2"))</td>
                    <td>
                        <span class="badge badge-@item.Status.ToLower()">@item.Status</span>
                        @if (item.JobOrder != null)
                        {
                            <span class="badge badge-accepted">Converted</span>
                        }
                    </td>
                    <td class="text-end pe-3 zx-actions">
                        <a asp-action="Details" asp-route-id="@item.QuotationID">View</a>
                        <a asp-action="Edit" asp-route-id="@item.QuotationID">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.QuotationID" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No quotations yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>