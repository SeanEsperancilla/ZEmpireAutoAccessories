@{
    ViewData["Title"] = "Dashboard";
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "there";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
    var roles = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
    var modules = User.FindAll(AppClaims.ModuleAccess).Select(c => c.Value).ToList();

    // Surface the Quotation tile for Admin and Staff. Quotation is not yet part
    // of the RBAC module grants (sec.Module / sec.RolePermission), so it is added
    // here explicitly. Once it is granted in the database this block can be
    // removed and the tile will flow through the claims automatically.
    if ((User.IsInRole("Admin") || User.IsInRole("Staff")) &&
        !modules.Contains("Quotation", StringComparer.OrdinalIgnoreCase))
    {
        modules.Add("Quotation");
    }

    // Cashiering has no row in sec.Module either - it only combines Sales and
    // Service Invoices, so holding either one is what opens it, matching the
    // gate on CashieringController. No database change needed to switch it on.
    if (modules.Contains("Sales", StringComparer.OrdinalIgnoreCase) ||
        modules.Contains("Service Invoices", StringComparer.OrdinalIgnoreCase))
    {
        modules.Add("Cashiering");
    }

    // Ordered category map. Modules render under the first category that lists
    // them, in the order defined here; anything not listed falls into "More".
    // Categories with no accessible modules are skipped, so a Staff role only
    // sees the sections it actually has tiles for.
    var categoryMap = new (string Name, string[] Modules)[]
    {
        ("Overview",              new[] { "Reports" }),
        ("Customers & Vehicles",  new[] { "Customers", "Vehicles", "Warranty" }),
        ("Operations",            new[] { "Job Orders", "Vehicle Checklist", "Services", "Job Types" }),
        ("Catalog & Inventory",   new[] { "Products", "Inventory", "Pricing", "Price History" }),
<<<<<<< HEAD
        ("Sales & Billing",       new[] { "Quotation", "Sales", "Service Invoices, Cashierin" }),
=======
        ("Sales & Billing",       new[] { "Quotation", "Sales", "Service Invoices", "Cashiering" }),
>>>>>>> 53dfb5b6420218aab94b057c293d1acb28c4a5ff
        ("Administration",        new[] { "User Management", "Roles" }),    
    };

    var moduleSet = new HashSet<string>(modules, StringComparer.OrdinalIgnoreCase);
    var claimed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    // Build each visible category with its accessible modules in defined order.
    var categories = new List<(string Name, List<string> Modules)>();
    foreach (var (name, mods) in categoryMap)
    {
        var owned = mods.Where(m => moduleSet.Contains(m)).ToList();
        foreach (var m in owned) { claimed.Add(m); }
        if (owned.Count > 0) { categories.Add((name, owned)); }
    }

    // Any module not covered by the map above.
    // var leftovers = modules.Where(m => !claimed.Contains(m)).OrderBy(m => m).ToList();
    // if (leftovers.Count > 0) { categories.Add(("More", leftovers)); }

    var stats = ViewData["Stats"] as List<DashboardStat> ?? new();
}

<style>
    .dash-hero {
        position: relative;
        overflow: hidden;
        color: #eef1f6;
        border-radius: 18px;
        padding: 28px 30px;
        margin-bottom: 22px;
        background: radial-gradient(560px 220px at 100% -30%, rgba(229,70,77,.35), transparent 60%), linear-gradient(135deg,#0b0b0c,#17171c);
        box-shadow: 0 22px 44px -26px rgba(0,0,0,.7);
        border: 1px solid #23232b;
    }

        .dash-hero h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            letter-spacing: .5px;
            font-size: 27px;
            margin: 0 0 8px;
        }

        .dash-hero p {
            margin: 0;
            color: #aab2c2;
        }

    .role-chip {
        display: inline-block;
        background: rgba(229,70,77,.18);
        color: #ff9296;
        border: 1px solid rgba(229,70,77,.45);
        padding: 2px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        margin-right: 6px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .cat-block {
        margin-bottom: 26px;
    }

    .cat-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 12px;
    }

        .cat-head::before {
            content: "";
            width: 4px;
            height: 18px;
            border-radius: 3px;
            background: linear-gradient(180deg,#e5464d,#c0202a);
        }

        .cat-head h2 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 600;
            letter-spacing: .4px;
            text-transform: uppercase;
            font-size: 15px;
            color: #0b0b0c;
            margin: 0;
        }

        .cat-head .cat-count {
            font-size: 11.5px;
            font-weight: 600;
            color: #98a0ad;
            background: #f1f3f7;
            border: 1px solid #e8ebf0;
            border-radius: 999px;
            padding: 1px 9px;
        }

    .mod-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 18px;
        height: 100%;
        transition: transform .1s ease, box-shadow .15s ease;
    }

        .mod-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 30px -20px rgba(2,6,23,.3);
            border-color: #f3c9cb;
        }

    .mod-ic {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        margin-bottom: 12px;
        background: linear-gradient(135deg,#fde8e9,#fbd3d5);
        color: #c0202a;
    }

    .mod-card h6 {
        font-weight: 700;
        margin: 0 0 2px;
        color: #0b0b0c;
    }

    .mod-card .soon {
        font-size: 11.5px;
        color: #98a0ad;
    }

    .mod-card .mod-blurb {
        font-size: 11.5px;
        color: #7b8290;
        margin: 0;
        line-height: 1.4;
    }

    a.mod-card, a.mod-card:hover {
        color: inherit;
        text-decoration: none;
    }

        a.mod-card:hover {
            border-color: #e5464d;
        }

    .mod-card .open {
        font-size: 12px;
        font-weight: 600;
        color: #c0202a;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .stat-row {
        margin-bottom: 22px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 14px 16px;
        height: 100%;
        text-decoration: none;
        color: inherit;
        transition: transform .1s ease, box-shadow .15s ease, border-color .15s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 30px -20px rgba(2,6,23,.3);
            border-color: #f3c9cb;
            color: inherit;
        }

    .stat-ic {
        flex: none;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg,#fde8e9,#fbd3d5);
        color: #c0202a;
    }

    .stat-value {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 19px;
        color: #0b0b0c;
        line-height: 1.15;
    }

    .stat-label {
        font-size: 12px;
        color: #7b8290;
        font-weight: 600;
    }

    .mod-search-wrap {
        position: relative;
        max-width: 380px;
        margin-bottom: 22px;
    }

        .mod-search-wrap svg {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #98a0ad;
        }

    .mod-search-input {
        padding-left: 38px;
        border-radius: 10px;
    }

    .mod-no-results {
        color: #7b8290;
        font-size: 13.5px;
        padding: 6px 2px 18px;
    }
</style>

<section class="dash-hero">
    <h1>Welcome back, @firstName </h1>
    <p>
        @foreach (var r in roles)
        {
            <span class="role-chip">@r</span>
        }
        Your role grants access to <strong>@modules.Count</strong> module@(modules.Count == 1 ? "" : "s")
        across <strong>@categories.Count</strong> categor@(categories.Count == 1 ? "y" : "ies").
    </p>
</section>

@if (stats.Count > 0)
{
    <div class="row g-3 stat-row">
        @foreach (var stat in stats)
        {
            <div class="col-6 col-lg-3">
                <a href="@stat.Link" class="stat-card">
                    <div class="stat-ic">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(StatIcon(stat.Icon))</svg>
                    </div>
                    <div>
                        <div class="stat-value">@stat.Value</div>
                        <div class="stat-label">@stat.Label</div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<div class="mod-search-wrap">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
    <input type="text" id="modSearch" class="form-control mod-search-input" placeholder="Search modules..." autocomplete="off" />
</div>
<div id="modNoResults" class="mod-no-results" hidden>No modules match your search.</div>

@foreach (var (name, mods) in categories)
{
    <div class="cat-block">
        <div class="cat-head">
            <h2>@name</h2>
            <span class="cat-count">@mods.Count</span>
        </div>
        <div class="row g-3">
            @foreach (var module in mods)
            {
                // Live modules link straight to their screen; the rest are still placeholders.
                string? route = module switch
                {
                    "Products" => Url.Action("Index", "Product"),
                    "Vehicles" => Url.Action("Index", "Vehicle"),
                    "Customers" => Url.Action("Index", "Customer"),
                    "User Management" => Url.Action("Index", "Employee"),
                    "Roles" => Url.Action("Index", "Security"),
                    "Quotation" => Url.Action("Index", "Quotation"),
                    "Job Types" => Url.Action("Index", "JobType"),
                    "Job Orders" => Url.Action("Index", "JobOrder"),
                    "Pricing" => Url.Action("Index", "Pricing"),
                    "Price History" => Url.Action("Index", "PriceHistory"),
                    "Inventory" => Url.Action("Index", "Inventory"),
                    "Sales" => Url.Action("Index", "Sales"),
                    "Vehicle Checklist" => Url.Action("Index", "VehicleChecklist"),
                    "Service Invoices" => Url.Action("Index", "ServiceInvoice"),
                    "Cashiering" => Url.Action("Index", "Cashiering"),
                    "Warranty" => Url.Action("Index", "Warranty"),
                    "Reports" => Url.Action("Index", "Report"),
                    "Services" => Url.Action("Index", "Service"),

                    _ => null
                };
                <div class="col-6 col-md-4 col-lg-3" data-mod-name="@module">
                    @if (route != null)
                    {
                        <a href="@route" class="mod-card d-flex flex-column">
                            <div class="mod-ic">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(ModuleIcon(module))</svg>
                            </div>
                            <h6>@module</h6>
                            <div class="mt-auto pt-2">
                                <span class="open">
                                    Open
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                                </span>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="mod-card d-flex flex-column">
                            <div class="mod-ic">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(ModuleIcon(module))</svg>
                            </div>
                            <h6>@module</h6>
                            <div class="mt-auto pt-2">
                                <span class="soon">Screen coming soon</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('modSearch');
            var noResults = document.getElementById('modNoResults');
            if (!input) { return; }

            function applyFilter() {
                var term = input.value.trim().toLowerCase();
                var anyVisible = false;

                document.querySelectorAll('.cat-block').forEach(function (block) {
                    var blockHasMatch = false;
                    block.querySelectorAll('[data-mod-name]').forEach(function (card) {
                        var name = card.getAttribute('data-mod-name').toLowerCase();
                        var match = term === '' || name.indexOf(term) !== -1;
                        card.hidden = !match;
                        if (match) { blockHasMatch = true; anyVisible = true; }
                    });
                    block.hidden = !blockHasMatch;
                });

                noResults.hidden = anyVisible || term === '';
            }

            input.addEventListener('input', applyFilter);

            // Press "/" anywhere on the page to jump into the module search.
            document.addEventListener('keydown', function (e) {
                if (e.key !== '/' || e.target === input) { return; }
                var tag = (e.target.tagName || '').toUpperCase();
                if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') { return; }
                e.preventDefault();
                input.focus();
            });
        })();
    </script>
}

