@{
    ViewData["Title"] = "Dashboard";
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "there";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
    var roles = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
    var modules = User.FindAll(AppClaims.ModuleAccess).Select(c => c.Value).OrderBy(m => m).ToList();
}

<style>
    .dash-hero { position:relative; overflow:hidden; color:#eef1f6; border-radius:18px; padding:28px 30px; margin-bottom:22px;
                 background:
                    radial-gradient(560px 220px at 100% -30%, rgba(229,70,77,.35), transparent 60%),
                    linear-gradient(135deg,#0b0b0c,#17171c);
                 box-shadow:0 22px 44px -26px rgba(0,0,0,.7); border:1px solid #23232b; }
    .dash-hero h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; letter-spacing:.5px; font-size:27px; margin:0 0 8px; }
    .dash-hero p { margin:0; color:#aab2c2; }
    .role-chip { display:inline-block; background:rgba(229,70,77,.18); color:#ff9296; border:1px solid rgba(229,70,77,.45);
                 padding:2px 11px; border-radius:999px; font-size:12px; font-weight:600; margin-right:6px; text-transform:uppercase; letter-spacing:.3px; }
    .mod-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:18px; height:100%;
                transition:transform .1s ease, box-shadow .15s ease; }
    .mod-card:hover { transform:translateY(-2px); box-shadow:0 16px 30px -20px rgba(2,6,23,.3); border-color:#f3c9cb; }
    .mod-ic { width:42px;height:42px;border-radius:11px;display:grid;place-items:center;margin-bottom:12px;
              background:linear-gradient(135deg,#fde8e9,#fbd3d5);color:#c0202a; }
    .mod-card h6 { font-weight:700; margin:0 0 2px; color:#0b0b0c; }
    .mod-card .soon { font-size:11.5px; color:#98a0ad; }
    .mod-card .open { font-size:11.5px; color:#c0202a; font-weight:600; }
    a.mod-card { text-decoration:none; }
</style>

<section class="dash-hero">
    <h1>Welcome back, @firstName 👋</h1>
    <p>
        @foreach (var r in roles) { <span class="role-chip">@r</span> }
        Your role grants access to <strong>@modules.Count</strong> module@(modules.Count == 1 ? "" : "s").
    </p>
</section>

<div class="row g-3">
    @foreach (var module in modules)
    {
        var (moduleController, moduleAction) = module switch
        {
            "Products" => ("Product", "Index"),
            "Vehicles" => ("Vehicle", "Index"),
            "Customers" => ("Customer", "Index"),
            "Employees" => ("Employee", "Index"),
            _ => (null, null)
        };

        <div class="col-6 col-md-4 col-lg-3">
            @if (moduleController != null)
            {
                <a class="mod-card d-flex flex-column" asp-controller="@moduleController" asp-action="@moduleAction">
                    <div class="mod-ic">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    </div>
                    <h6>@module</h6>
                    <div class="mt-auto pt-2">
                        <span class="open">Open module &rarr;</span>
                    </div>
                </a>
            }
            else
            {
                <div class="mod-card d-flex flex-column">
                    <div class="mod-ic">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    </div>
                    <h6>@module</h6>
                    <div class="mt-auto pt-2">
                        <span class="soon">Screen coming soon</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
