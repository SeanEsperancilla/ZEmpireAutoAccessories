@model ZEmpireAutoAccessories.Models.VehicleClassification

@{
    ViewData["Title"] = "Delete Vehicle Classification";
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 18px; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #f3c9cb; border-radius:14px; padding:24px; max-width:560px; }
</style>

<div class="zx-page-head">
    <h1>Delete Vehicle Classification</h1>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete this classification? This cannot be undone
    @(Model.Vehicles.Count > 0 ? $" and will fail while {Model.Vehicles.Count} vehicle(s) still reference it." : ".")
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ClassificationName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ClassificationName)</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="VehicleClassificationID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
