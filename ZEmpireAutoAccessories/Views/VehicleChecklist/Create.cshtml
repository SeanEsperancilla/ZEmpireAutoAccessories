@model ZEmpireAutoAccessories.Models.VehicleChecklist

@{
    ViewData["Title"] = "New Vehicle Checklist";
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 18px;
        color: #0b0b0c;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 640px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }
</style>

<div class="zx-page-head">
    <h1>New Vehicle Checklist</h1>
</div>

<div class="zx-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="JobOrderID" class="form-label">Job Order</label>
            <select asp-for="JobOrderID" class="form-select" asp-items="ViewBag.JobOrderID">
                <option value="">-- Select Job Order --</option>
            </select>
            <span asp-validation-for="JobOrderID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AdditionalNotes" class="form-label"></label>
            <textarea asp-for="AdditionalNotes" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="ClientSignature" class="form-label">Client Confirmation <span class="text-muted fw-normal">(typed name, optional)</span></label>
            <input asp-for="ClientSignature" class="form-control" />
        </div>

        <button type="submit" class="btn btn-zx">Save &amp; Add Panel Conditions</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}