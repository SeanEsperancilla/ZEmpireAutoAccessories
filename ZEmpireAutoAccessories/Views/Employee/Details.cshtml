@model ZEmpireAutoAccessories.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    
</style>

<div class="zx-page-head">
    <h1>Employee Details</h1>
    <a class="btn btn-zx" asp-action="Edit" asp-route-id="@Model.EmployeeID">Edit</a>
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmployeeNumber)</dt>
        <dd class="col-sm-9">@Model.EmployeeNumber</dd>

        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FirstName @Model.MiddleName @Model.LastName @Model.Suffix</dd>

        <dt class="col-sm-3">Login Account</dt>
        <dd class="col-sm-9">@Model.User.UserName</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ContactNumber)</dt>
        <dd class="col-sm-9">@(Model.ContactNumber ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmailAddress)</dt>
        <dd class="col-sm-9">@(Model.EmailAddress ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsActive)</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM d, yyyy")</dd>

        <dt class="col-sm-3">Last Updated</dt>
        <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("MMM d, yyyy") ?? "—")</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Index" class="back-link">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        Back to list
    </a>
</div>
