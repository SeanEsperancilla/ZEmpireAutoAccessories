@model ZEmpireAutoAccessories.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
    var successMessage = TempData["Success"] as string;
    var resetPasswordError = TempData["ResetPasswordError"] as string;
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .btn-zx, .btn-outline-secondary { display:inline-flex; align-items:center; gap:7px; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .badge-active { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-inactive { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
    #resetPasswordModal .modal-content { border-radius:14px; border:none; }
    #resetPasswordModal .modal-title { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:19px; }
    .field-hint { color:#7b8290; font-size:12.5px; margin-top:4px; }
    .password-wrap { position:relative; }
    .password-wrap input { padding-right:40px; }
    .toggle-pass-btn {
        position:absolute; right:6px; top:50%; transform:translateY(-50%);
        border:none; background:none; padding:6px; color:#98a0ad; cursor:pointer;
        display:grid; place-items:center; border-radius:6px;
    }
    .toggle-pass-btn:hover { color:#4b5563; background:#f1f3f7; }
</style>

<div class="zx-page-head">
    <h1>Employee Details</h1>
    <div>
        <a class="btn btn-zx" asp-action="Edit" asp-route-id="@Model.EmployeeID">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            Edit
        </a>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Reset Password
        </button>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Back to list
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(resetPasswordError))
{
    <div class="alert alert-danger">@resetPasswordError</div>
}

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmployeeNumber)</dt>
        <dd class="col-sm-9">@Model.EmployeeNumber</dd>

        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FirstName @Model.MiddleName @Model.LastName @Model.Suffix</dd>

        <dt class="col-sm-3">Login Account</dt>
        <dd class="col-sm-9">@Model.User.UserName</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ContactNumber)</dt>
        <dd class="col-sm-9">@(Model.ContactNumber ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmailAddress)</dt>
        <dd class="col-sm-9">@(Model.EmailAddress ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsActive)</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge badge-active">Active</span>
            }
            else
            {
                <span class="badge badge-inactive">Inactive</span>
            }
        </dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM d, yyyy")</dd>

        <dt class="col-sm-3">Last Updated</dt>
        <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("MMM d, yyyy") ?? "—")</dd>
    </dl>
</div>

<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Employee" asp-action="ResetPassword" method="post">
                <input type="hidden" name="id" value="@Model.EmployeeID" />
                <div class="modal-header">
                    <h5 class="modal-title" id="resetPasswordModalLabel">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Set a new password for <strong>@Model.User.UserName</strong>. They won't need their old one.</p>

                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <div class="password-wrap">
                            <input type="password" name="newPassword" class="form-control" autocomplete="new-password" required />
                            <button type="button" class="toggle-pass-btn" aria-label="Show password" tabindex="-1">
                                <svg class="eye-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <div class="field-hint">At least 8 characters, with an uppercase letter, a lowercase letter, a digit, and a symbol.</div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label">Confirm New Password</label>
                        <div class="password-wrap">
                            <input type="password" name="confirmPassword" class="form-control" autocomplete="new-password" required />
                            <button type="button" class="toggle-pass-btn" aria-label="Show password" tabindex="-1">
                                <svg class="eye-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-zx">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-pass-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        });
    </script>
}
