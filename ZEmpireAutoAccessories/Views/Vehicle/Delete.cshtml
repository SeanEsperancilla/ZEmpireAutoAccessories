@model ZEmpireAutoAccessories.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 18px; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #f3c9cb; border-radius:14px; padding:24px; max-width:560px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
</style>

<div class="zx-page-head">
    <h1>Delete Vehicle</h1>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete this vehicle? This cannot be undone.
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.PlateNumber)</dt>
        <dd class="col-sm-8">@(Model.PlateNumber ?? "—")</dd>

        <dt class="col-sm-4">Vehicle</dt>
        <dd class="col-sm-8">@Model.Brand @Model.Model (@(Model.ManufacturingYear?.ToString() ?? "—"))</dd>

        <dt class="col-sm-4">Classification</dt>
        <dd class="col-sm-8">@Model.VehicleClassification.ClassificationName</dd>

        <dt class="col-sm-4">Owner</dt>
        <dd class="col-sm-8">@Model.Customer.FullName</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="VehicleID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
