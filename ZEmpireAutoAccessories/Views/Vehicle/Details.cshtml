@model ZEmpireAutoAccessories.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
</style>

<div class="zx-page-head">
    <h1>Vehicle Details</h1>
    <a class="btn btn-zx" asp-action="Edit" asp-route-id="@Model.VehicleID">Edit</a>
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PlateNumber)</dt>
        <dd class="col-sm-9">@(Model.PlateNumber ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Brand)</dt>
        <dd class="col-sm-9">@(Model.Brand ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Model)</dt>
        <dd class="col-sm-9">@(Model.Model ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ManufacturingYear)</dt>
        <dd class="col-sm-9">@(Model.ManufacturingYear?.ToString() ?? "—")</dd>

        <dt class="col-sm-3">Classification</dt>
        <dd class="col-sm-9">@Model.VehicleClassification.ClassificationName</dd>

        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">@Model.Customer.FullName</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Index">&larr; Back to list</a>
</div>
