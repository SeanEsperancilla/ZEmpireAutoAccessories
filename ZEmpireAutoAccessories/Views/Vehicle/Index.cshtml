@model IEnumerable<Vehicle>
@{
    ViewData["Title"] = "Vehicles";
    var search = ViewData["Search"] as string;
    var list = Model.ToList();

    string VName(Vehicle v)
    {
        var n = $"{v.Brand} {v.Model}".Trim();
        return n.Length == 0 ? (string.IsNullOrWhiteSpace(v.PlateNumber) ? $"Vehicle #{v.VehicleID}" : v.PlateNumber!) : n;
    }
}

@await Html.PartialAsync("_CrmStyles")

<section class="crm-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="eyebrow">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
                Vehicle Records
            </span>
            <h1>Vehicles</h1>
            <p>Track every vehicle and the customer it belongs to.</p>
        </div>
        <div class="hero-actions">
            <a asp-action="Create" class="btn-zx">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                Add Vehicle
            </a>
        </div>
    </div>
</section>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success d-flex align-items-center gap-2 border-0" style="border-radius:12px; background:#e7f7ee; color:#166534;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span>@ok</span>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 border-0" style="border-radius:12px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        <span>@err</span>
    </div>
}

<div class="crm-panel">
    <div class="crm-toolbar">
        <form asp-action="Index" method="get" class="crm-search" role="search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" name="q" value="@search" placeholder="Search plate, brand, model or owner…" aria-label="Search vehicles" />
        </form>
        <span class="crm-count">
            @list.Count @(list.Count == 1 ? "vehicle" : "vehicles")@(string.IsNullOrWhiteSpace(search) ? "" : $" matching “{search}”")
        </span>
    </div>

    @if (list.Count == 0)
    {
        <div class="crm-empty">
            <div class="ic">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
            </div>
            @if (string.IsNullOrWhiteSpace(search))
            {
                <h3>No vehicles yet</h3>
                <p>Register your first vehicle and link it to a customer.</p>
                <a asp-action="Create" class="btn-zx d-inline-flex">Add Vehicle</a>
            }
            else
            {
                <h3>No matches found</h3>
                <p>No vehicle matches “@search”. Try a different search.</p>
                <a asp-action="Index" class="btn-outline-zx d-inline-flex">Clear search</a>
            }
        </div>
    }
    else
    {
        <!-- Desktop / tablet table -->
        <div class="d-none d-lg-block">
            <table class="crm-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Owner</th>
                        <th>Classification</th>
                        <th>Year</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in list)
                    {
                        <tr>
                            <td>
                                <div class="crm-id">
                                    <span class="crm-avatar">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
                                    </span>
                                    <span>
                                        <span class="nm d-block">@VName(v)</span>
                                        <span class="sub">@(string.IsNullOrWhiteSpace(v.PlateNumber) ? "No plate" : v.PlateNumber)</span>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@v.CustomerID" class="text-decoration-none text-reset fw-medium">
                                    @(v.Customer?.FullName ?? "—")
                                </a>
                            </td>
                            <td><span class="crm-chip">@(v.VehicleClassification?.ClassificationName ?? "—")</span></td>
                            <td>@(v.ManufacturingYear?.ToString() ?? "—")</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-end crm-actions">
                                    <a asp-action="Details" asp-route-id="@v.VehicleID" class="btn-ghost" title="View" aria-label="View">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@v.VehicleID" class="btn-ghost" title="Edit" aria-label="Edit">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@v.VehicleID" class="btn-ghost danger" title="Delete" aria-label="Delete">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile cards -->
        <div class="d-lg-none">
            @foreach (var v in list)
            {
                <div class="crm-mcard">
                    <div class="row-top">
                        <span class="crm-avatar">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
                        </span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="nm fw-semibold text-truncate" style="color:#0b0b0c;">@VName(v)</div>
                            <div class="sub" style="font-size:12px;color:#98a0ad;">@(string.IsNullOrWhiteSpace(v.PlateNumber) ? "No plate" : v.PlateNumber)</div>
                        </div>
                    </div>
                    <div class="meta">
                        <span class="crm-chip">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            @(v.Customer?.FullName ?? "—")
                        </span>
                        <span class="crm-chip">@(v.VehicleClassification?.ClassificationName ?? "—")</span>
                        @if (v.ManufacturingYear != null)
                        {
                            <span class="crm-chip">@v.ManufacturingYear</span>
                        }
                    </div>
                    <div class="acts">
                        <a asp-action="Details" asp-route-id="@v.VehicleID" class="btn-outline-zx btn-sm">View</a>
                        <a asp-action="Edit" asp-route-id="@v.VehicleID" class="btn-outline-zx btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@v.VehicleID" class="btn-outline-zx btn-sm" style="color:#c0202a;">Delete</a>
                    </div>
                </div>
            }
        </div>
    }
