@model ZEmpireAutoAccessories.Models.Vehicle

@{
    ViewData["Title"] = "New Vehicle";
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .zx-page-sub {
        color: #7b8290;
        font-size: 13.5px;
        margin: 0 0 18px;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 640px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .form-label {
        font-weight: 600;
        font-size: 13.5px;
        color: #0b0b0c;
    }
</style>

<div class="zx-page-head">
    <h1>New Vehicle</h1>
</div>
<p class="zx-page-sub">Register a vehicle under an existing customer.</p>

<div class="zx-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerID" class="form-label"></label>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleClassificationID" class="form-label"></label>
                <select asp-for="VehicleClassificationID" class="form-select" asp-items="ViewBag.VehicleClassificationID">
                    <option value="">-- Select Classification --</option>
                </select>
                <span asp-validation-for="VehicleClassificationID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PlateNumber" class="form-label"></label>
                <input asp-for="PlateNumber" class="form-control" placeholder="e.g. ABC 1234" />
                <span asp-validation-for="PlateNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" placeholder="e.g. Toyota" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" placeholder="e.g. Vios" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="ManufacturingYear" class="form-label"></label>
            <input asp-for="ManufacturingYear" class="form-control" />
            <span asp-validation-for="ManufacturingYear" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-zx">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
            Save
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}