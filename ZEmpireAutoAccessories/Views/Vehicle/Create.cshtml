@model Vehicle
@{
    ViewData["Title"] = "Add Vehicle";
}

@await Html.PartialAsync("_CrmStyles")

<section class="crm-hero">
    <a asp-action="Index" class="back d-inline-flex align-items-center gap-1 mb-2">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to vehicles
    </a>
    <h1>Add Vehicle</h1>
    <p>Register a vehicle and link it to its owner.</p>
</section>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="crm-panel crm-panel-pad">
            <form asp-action="Create" method="post" novalidate>
                <partial name="_Form" model="Model" />
                <div class="crm-form-actions">
                    <button type="submit" class="btn-zx">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        Add vehicle
                    </button>
                    <a asp-action="Index" class="btn-outline-zx">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
