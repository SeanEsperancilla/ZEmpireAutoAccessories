@model ZEmpireAutoAccessories.Models.JobType

@{
    ViewData["Title"] = "New Job Type";
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .zx-page-sub {
        color: #7b8290;
        font-size: 13.5px;
        margin: 0 0 18px;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 480px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }
</style>

<div class="zx-page-head">
    <h1>New Job Type</h1>
</div>
<p class="zx-page-sub">Add a job type customers can be booked under.</p>

<div class="zx-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="JobTypeName" class="form-label"></label>
            <input asp-for="JobTypeName" class="form-control" autofocus />
            <span asp-validation-for="JobTypeName" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-zx">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
            Save
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}