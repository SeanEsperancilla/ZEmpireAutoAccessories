@model ZEmpireAutoAccessories.Models.JobType

@{
    ViewData["Title"] = "Delete Job Type";
    var blockReason = ViewData["BlockReason"] as string;
    var deleteError = TempData["DeleteError"] as string;
    var blocked = !string.IsNullOrEmpty(blockReason) || !string.IsNullOrEmpty(deleteError);
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 18px;
        color: #0b0b0c;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #f3c9cb;
        border-radius: 14px;
        padding: 24px;
        max-width: 480px;
    }

    dt {
        color: #7b8290;
        font-weight: 600;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    dd {
        margin-bottom: 14px;
        font-size: 15px;
        color: #0b0b0c;
    }
</style>

<div class="zx-page-head">
    <h1>Delete Job Type</h1>
</div>

@if (!string.IsNullOrEmpty(deleteError))
{
    <div class="alert alert-danger">@deleteError</div>
}
else if (!string.IsNullOrEmpty(blockReason))
{
    <div class="alert alert-danger">@blockReason</div>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete this job type? This cannot be undone.
    </div>
}

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.JobTypeName)</dt>
        <dd class="col-sm-8">@Model.JobTypeName</dd>
    </dl>
</div>

<div class="mt-3">
    @if (blocked)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    }
    else
    {
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="JobTypeID" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div>