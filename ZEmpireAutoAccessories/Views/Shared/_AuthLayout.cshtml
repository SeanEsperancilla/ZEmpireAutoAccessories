<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Z-Empire</title>
    <link rel="icon" href="~/images/ZEmpireLogo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --zx-black:  #0b0b0c;   /* brand base (from site) */
            --zx-panel:  #141418;   /* card surface */
            --zx-panel2: #1b1b21;   /* input surface */
            --zx-line:   #2a2a33;   /* hairlines */
            --zx-red:    #e5464d;   /* brand red (from site) */
            --zx-red2:   #e11d22;   /* logo red */
            --zx-red-d:  #b01822;   /* deep red */
            --zx-silver: #c7ccd1;   /* badge rim */
            --zx-muted:  #8b93a1;
            --zx-text:   #eef1f6;
            --ring:      rgba(229,70,77,.35);
        }

        * { box-sizing: border-box; }

        body.auth-body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: var(--zx-text);
            background:
                radial-gradient(1100px 560px at 88% -12%, rgba(229,70,77,.20), transparent 58%),
                radial-gradient(760px 460px at -8% 112%, rgba(229,70,77,.10), transparent 55%),
                linear-gradient(180deg, #0a0a0b 0%, #101014 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .auth-card {
            width: 100%;
            max-width: 960px;
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            background: var(--zx-panel);
            border: 1px solid var(--zx-line);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 40px 90px -30px rgba(0,0,0,.85), 0 0 0 1px rgba(255,255,255,.02);
        }

        /* ---- brand panel ---- */
        .auth-brand {
            position: relative;
            padding: 46px 42px;
            background:
                radial-gradient(520px 260px at 115% -10%, rgba(229,70,77,.35), transparent 60%),
                linear-gradient(160deg, #121216, #0a0a0c);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            border-right: 1px solid var(--zx-line);
        }
        .auth-brand::before {
            content: "";
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
            background-size: 26px 26px;
            mask-image: radial-gradient(400px 400px at 30% 20%, #000, transparent 75%);
        }
        .brand-logo { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; }
        .brand-logo img { width: 58px; height: 58px; filter: drop-shadow(0 6px 14px rgba(0,0,0,.6)); }
        .brand-logo .wm { font-family: 'Oswald', system-ui, sans-serif; font-weight: 700; font-size: 22px; letter-spacing: 1px; }
        .brand-logo .wm b { color: var(--zx-red); }

        .brand-copy { position: relative; z-index: 1; margin-top: 30px; }
        .brand-copy h1 { font-family:'Oswald',sans-serif; font-size: 32px; line-height: 1.12; font-weight: 700; letter-spacing:.5px; margin: 0 0 10px; text-transform: uppercase; }
        .brand-copy h1 span { color: var(--zx-red); }
        .brand-copy p { color: #aab2c2; margin: 0; font-size: 14.5px; }
        .brand-points { list-style: none; padding: 0; margin: 26px 0 0; position: relative; z-index: 1; }
        .brand-points li { display: flex; align-items: center; gap: 11px; margin: 13px 0; font-size: 14px; color: #c4ccda; }
        .brand-points .tick { flex:none; width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:#fff;
                              background:linear-gradient(135deg,var(--zx-red),var(--zx-red-d)); }
        .brand-foot { position: relative; z-index: 1; font-size: 12px; color: #6f7688; letter-spacing:.3px; }

        /* ---- form panel ---- */
        .auth-form { padding: 46px 44px; display: flex; flex-direction: column; justify-content: center; }
        .form-logo { display:none; text-align:center; margin-bottom: 14px; }
        .form-logo img { width: 76px; height: 76px; }
        .auth-form h2 { font-family:'Oswald',sans-serif; font-weight: 700; font-size: 26px; letter-spacing:.5px; margin: 0 0 4px; text-transform: uppercase; }
        .auth-form .sub { color: var(--zx-muted); font-size: 14px; margin: 0 0 24px; }

        .field { margin-bottom: 16px; }
        .field label { font-size: 12.5px; font-weight: 600; color: #b7bfce; margin-bottom: 6px; display: block; letter-spacing:.2px; }
        .input-wrap { position: relative; }
        .input-wrap svg.lead { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #6f7688; }
        .input-wrap .form-control {
            height: 48px; border-radius: 12px; border: 1px solid var(--zx-line);
            padding-left: 42px; font-size: 14.5px; background: var(--zx-panel2); color: var(--zx-text);
            transition: border-color .15s, box-shadow .15s, background .15s;
        }
        .input-wrap .form-control::placeholder { color: #5e6675; }
        .input-wrap .form-control:focus {
            border-color: var(--zx-red); background: #202027;
            box-shadow: 0 0 0 4px var(--ring); outline: none; color: #fff;
        }
        .toggle-pass {
            position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
            border: none; background: transparent; color: #6f7688; padding: 8px; cursor: pointer; border-radius: 8px;
        }
        .toggle-pass:hover { color: #cfd6e2; background: rgba(255,255,255,.05); }

        .row-between { display: flex; align-items: center; justify-content: space-between; margin: 4px 0 22px; }
        .remember { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: #b7bfce; }
        .remember input { width: 16px; height: 16px; accent-color: var(--zx-red); }

        .btn-signin {
            width: 100%; height: 48px; border: none; border-radius: 12px;
            font-family:'Oswald',sans-serif; font-weight: 700; font-size: 16px; letter-spacing:.6px; text-transform: uppercase;
            color: #fff; cursor: pointer;
            background: linear-gradient(135deg, var(--zx-red), var(--zx-red-d));
            box-shadow: 0 14px 26px -12px rgba(229,70,77,.8);
            transition: transform .05s ease, filter .15s ease;
        }
        .btn-signin:hover { filter: brightness(1.06); }
        .btn-signin:active { transform: translateY(1px); }

        .alert-danger { background: rgba(229,70,77,.12); border: 1px solid rgba(229,70,77,.4); color: #ffb3b7; border-radius: 12px; font-size: 13.5px; }
        .val-summary ul { margin: 0; padding-left: 18px; }
        .field-error { color: #ff8a8f; font-size: 12.5px; margin-top: 5px; display: block; }

        .form-foot { text-align: center; margin-top: 22px; color: #6f7688; font-size: 12px; letter-spacing:.3px; }

        a.btn, .btn { font-family: inherit; }

        @@media (max-width: 820px) {
            .auth-card { grid-template-columns: 1fr; max-width: 440px; }
            .auth-brand { display: none; }
            .auth-form { padding: 34px 26px; }
            .form-logo { display: block; }
        }
    </style>
</head>
<body class="auth-body">
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
