@model ZEmpireAutoAccessories.Models.CutSizeGrid

@{
    ViewData["Title"] = "Cut Sizes";
    var successMessage = TempData["Success"] as string;
    var cutSizeError = ViewData["CutSizeError"] as string;
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 4px; color:#0b0b0c; }
    .zx-page-sub { color:#7b8290; font-size:13.5px; margin:0 0 18px; max-width:760px; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; margin-bottom:18px; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }

    .cut-table { border-collapse:separate; border-spacing:0; width:100%; }
    .cut-table th, .cut-table td { padding:8px 10px; font-size:13.5px; border-bottom:1px solid #eef1f5; }
    .cut-table thead th { background:#0b0b0c; color:#fff; font-weight:600; font-size:12px;
                          text-transform:uppercase; letter-spacing:.3px; white-space:nowrap; }

    /* The vehicle class stays put while the panels scroll sideways - a wide
       grid is unreadable if you cannot see which row you are on. */
    .cut-table th.rowhead { position:sticky; left:0; background:#fff; z-index:2; font-weight:600;
                            color:#0b0b0c; text-align:left; white-space:nowrap; box-shadow:1px 0 0 #eef1f5; }
    .cut-table thead th.rowhead { background:#0b0b0c; color:#fff; }

    .cut-input { width:88px; text-align:right; font-variant-numeric:tabular-nums;
                 border:1px solid #e2e6ec; border-radius:7px; padding:5px 8px; font-size:13.5px; }
    .cut-input:focus { outline:none; border-color:var(--zx-red); box-shadow:0 0 0 3px rgba(193,18,31,.1); }
    .cut-input.is-set { border-color:#bbf7d0; background:#f6fefa; }

    .cut-legend { color:#7b8290; font-size:12.5px; margin-top:12px; }
    .cut-count { font-weight:600; color:#0b0b0c; }

    /* The unit lives beside every box, not only in a sentence at the bottom.
       A grid of bare numbers is the one thing that must not be ambiguous. */
    .cut-cell { display:flex; align-items:center; gap:4px; }
    .cut-unit { color:#9aa1ad; font-size:11.5px; }

    .unit-bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
    .unit-label { font-size:12.5px; font-weight:600; color:#7b8290;
                  text-transform:uppercase; letter-spacing:.3px; }
    .unit-pill { padding:4px 12px; border-radius:999px; border:1px solid #e2e6ec; background:#fff;
                 color:#4b5563; font-size:12.5px; font-weight:600; text-decoration:none; }
    .unit-pill:hover { border-color:#c9ced6; color:#0b0b0c; }
    .unit-pill.active { background:#0b0b0c; border-color:#0b0b0c; color:#fff; }
</style>

<div class="zx-page-head">
    <h1>Cut Sizes</h1>
</div>
<p class="zx-page-sub">
    How much film each panel takes, per class of vehicle. When a tint or film job is completed,
    this is what comes off the roll &mdash; a line reading &ldquo;Front Windshield &times;1&rdquo; deducts the
    length set here, not one of anything. Leave a box empty where the panel does not apply;
    a job that uses an empty pairing cannot be completed until it is filled in.
</p>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(cutSizeError))
{
    <div class="alert alert-danger">@cutSizeError</div>
}

@if (Model.Classifications.Count == 0 || Model.Panels.Count == 0)
{
    <div class="zx-card">
        <p class="mb-0 text-muted">
            @(Model.Classifications.Count == 0
                ? "There are no vehicle classifications yet. Add one before setting cut sizes."
                : "There are no panels yet. Add one before setting cut sizes.")
        </p>
    </div>
}
else
{
    <div class="unit-bar">
        <span class="unit-label">Measured in</span>
        @foreach (var unit in UnitOfMeasure.LengthUnits)
        {
            <a class="unit-pill @(Model.Unit == unit ? "active" : "")"
               asp-action="Index" asp-route-unit="@unit">@UnitName(unit)</a>
        }
        <span class="cut-legend" style="margin:0 0 0 6px;">
            Switching converts what is already here &mdash; nothing is retyped or lost.
        </span>
    </div>

    @if (Model.Fillable > 0)
    {
        @* Typing a hundred boxes from nothing is why this table sits empty in
           most shops. These are estimates and say so, and they only ever land
           in boxes that are blank. *@
        <form method="post" asp-action="FillSuggested" class="mb-3">
            <input type="hidden" name="unit" value="@Model.Unit" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                Fill @Model.Fillable blank glass box@(Model.Fillable == 1 ? "" : "es") with starting sizes
            </button>
            <span class="cut-legend" style="margin-left:6px;">
                Estimates for glass only, scaled by vehicle class. Check them against a real job.
            </span>
        </form>
    }

    <form method="post" asp-action="Index">
        <input type="hidden" name="unit" value="@Model.Unit" />
        <div class="zx-card">
            <div class="table-responsive">
                <table class="cut-table">
                    <thead>
                        <tr>
                            <th class="rowhead">Vehicle Class</th>
                            @foreach (var panel in Model.Panels)
                            {
                                <th>@panel.PanelName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classification in Model.Classifications)
                        {
                            <tr>
                                <th class="rowhead">@classification.ClassificationName</th>
                                @foreach (var panel in Model.Panels)
                                {
                                    var size = Model.For(classification.VehicleClassificationID, panel.PanelID);
                                    var suggested = Model.Suggested(classification, panel);
                                    <td>
                                        @* Every box posts its own pair of ids, so the server never has
                                           to work out which cell a number belonged to. *@
                                        <input type="hidden" name="vehicleClassificationId" value="@classification.VehicleClassificationID" />
                                        <input type="hidden" name="panelId" value="@panel.PanelID" />
                                        <div class="cut-cell">
                                            <input type="number" name="size" step="@(Model.Unit == UnitOfMeasure.Centimeter ? "0.1" : "0.01")" min="0"
                                                   class="cut-input @(size.HasValue ? "is-set" : "")"
                                                   value="@(size.HasValue ? Model.Format(size.Value) : "")"
                                                   placeholder="@(suggested.HasValue ? Model.Format(suggested.Value) : "—")"
                                                   title="@(suggested.HasValue ? $"Suggested: {Model.Format(suggested.Value)} {Model.Unit}" : null)"
                                                   aria-label="@classification.ClassificationName, @panel.PanelName, in @UnitName(Model.Unit)" />
                                            <span class="cut-unit">@Model.Unit</span>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cut-legend">
                <span class="cut-count">@Model.Filled of @Model.Total</span> pairings have a cut size.
                All figures on this screen are in @UnitName(Model.Unit) (@Model.Unit); they are kept in
                centimetres underneath, which is what stock is counted in.
                A greyed figure in an empty box is a suggestion, not a saved value.
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Save Cut Sizes
            </button>
            <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary">Back to Inventory</a>
        </div>
    </form>
}

@functions {
    // "m" is fine beside a box; a sentence wants the word.
    static string UnitName(string unit) => unit switch
    {
        UnitOfMeasure.Centimeter => "centimetres",
        UnitOfMeasure.Inch => "inches",
        UnitOfMeasure.Meter => "metres",
        _ => unit
    };
}
