@model ZEmpireAutoAccessories.Models.Warranty

@{
    ViewData["Title"] = "Warranty Details";
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 18px;
    }

    dt {
        color: #7b8290;
        font-weight: 600;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    dd {
        margin-bottom: 14px;
        font-size: 15px;
        color: #0b0b0c;
    }

    .badge-active {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-expired {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }

    .badge-voided {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .badge-claimed {
        background: rgba(245,158,11,.15);
        color: #b45309;
        font-weight: 600;
    }
</style>

<div class="zx-page-head">
    <h1>Warranty #@Model.WarrantyID</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.WarrantyID">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">Linked To</dt>
        <dd class="col-sm-9">
            @if (Model.SalesDetail != null)
            {
                @:Sale @Model.SalesDetail.Sale.InvoiceNumber — @Model.SalesDetail.Product.ProductName (Qty @Model.SalesDetail.Quantity)
            }
            else if (Model.ServiceInvoiceDetail != null)
            {
                @:Service Invoice @Model.ServiceInvoiceDetail.ServiceInvoice.InvoiceNumber — @Model.ServiceInvoiceDetail.Description
            }
            else if (Model.JobOrder != null)
            {
                @:Job Order @Model.JobOrder.JobOrderNumber — @Model.JobOrder.Customer.FullName
            }
            else
            {
                @:—
            }
        </dd>

        <dt class="col-sm-3">Warranty Start</dt>
        <dd class="col-sm-9">@(Model.WarrantyStartDate?.ToString("MMM d, yyyy") ?? "—")</dd>

        <dt class="col-sm-3">Warranty End</dt>
        <dd class="col-sm-9">@(Model.WarrantyEndDate?.ToString("MMM d, yyyy") ?? "—")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.WarrantyStatus))
            {
                <span class="badge badge-@Model.WarrantyStatus.ToLower()">@Model.WarrantyStatus</span>
            }
            else
            {
                @:—
            }
        </dd>

        @if (!string.IsNullOrEmpty(Model.WarrantyTerms))
        {
            <dt class="col-sm-3">Terms</dt>
            <dd class="col-sm-9">@Model.WarrantyTerms</dd>
        }

        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <dt class="col-sm-3">Remarks</dt>
            <dd class="col-sm-9">@Model.Remarks</dd>
        }

        @if (!string.IsNullOrEmpty(Model.CreatedBy))
        {
            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Model.CreatedBy</dd>
        }
    </dl>
</div>