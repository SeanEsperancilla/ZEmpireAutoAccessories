@model ZEmpireAutoAccessories.Models.ServiceInvoice

@{
    ViewData["Title"] = "Edit Service Invoice";
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 4px; color:#0b0b0c; }
    .zx-page-sub { color:#7b8290; font-size:13.5px; margin:0 0 18px; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:24px; max-width:720px; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; display:inline-flex; align-items:center; gap:7px; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
</style>

<div class="zx-page-head">
    <h1>Edit Invoice @Model.InvoiceNumber</h1>
</div>
<p class="zx-page-sub">Update this invoice's details.</p>

<div class="zx-card">
    <form asp-action="Edit" method="post" class="zx-form">
        <input type="hidden" asp-for="ServiceInvoiceID" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerID" class="form-label"></label>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleID" class="form-label">Vehicle <span class="text-muted fw-normal">(optional)</span></label>
                <select asp-for="VehicleID" class="form-select" asp-items="ViewBag.VehicleID">
                    <option value="">-- None --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="JobOrderID" class="form-label">Job Order <span class="text-muted fw-normal">(optional)</span></label>
                <select asp-for="JobOrderID" class="form-select" asp-items="ViewBag.JobOrderID">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PaymentModeID" class="form-label"></label>
                <select asp-for="PaymentModeID" class="form-select" asp-items="ViewBag.PaymentModeID">
                    <option value="">-- Select Payment Mode --</option>
                </select>
                <span asp-validation-for="PaymentModeID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DiscountAmount" class="form-label"></label>
                <input asp-for="DiscountAmount" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">VAT (@Vat.RateLabel)</label>
                @* Prices are quoted VAT-inclusive, so the 12% is already in
                   the total and is worked out of it rather than typed in.
                   TaxAmount is carried through untouched: on an older document
                   that has a figure in it, CK_ServiceInvoice_Math has already
                   counted it in the total, and blanking it here would change
                   what the document says is owed. *@
                <input type="hidden" asp-for="TaxAmount" />
                <input type="text" class="form-control" readonly tabindex="-1"
                       value="@("₱" + Vat.Amount(Model.TotalAmount).ToString("N2"))" />
                <div class="form-text">Computed automatically - it is inside the total, not added to it.</div>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="AmountPaid" class="form-label"></label>
                <input asp-for="AmountPaid" type="number" step="0.01" min="0" class="form-control" id="amountPaid" />
                <span asp-validation-for="AmountPaid" class="text-danger"></span>
                @* The invoice stores payment in full plus change, so a part
                   payment has nowhere to go - say so before the round trip. *@
                <div class="form-text" id="amountPaidHelpCash">
                    Must cover the total of @("₱" + Model.TotalAmount.ToString("N2")). Anything above it is recorded as change.
                    Taking payment and marking the invoice Paid is done from <strong>Take payment</strong> on the invoice itself;
                    this only corrects the figure on record.
                </div>
                <div class="form-text d-none" id="amountPaidHelpExact">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-right:3px"><rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    Set to the total of <span id="amountPaidExactTotal"></span> automatically. Only cash is
                    handed over and change given back &mdash; a transfer, GCash or a card is taken for
                    the amount due and nothing else.
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Remarks" class="form-label">Remarks <span class="text-muted fw-normal">(optional)</span></label>
            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Save Changes
            </button>
            <a asp-action="Details" asp-route-id="@Model.ServiceInvoiceID" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* Only cash is handed over and change given back. For every other mode the
       tendered amount IS the total, so fill it in and lock the field rather
       than inviting a figure the server will overwrite anyway.

       The server applies the same rule on save - this field posts whether or
       not it is read-only, and a form can be replayed - so this is here to
       make the rule visible, not to enforce it. Both read the same list of
       mode ids, so they cannot disagree. *@
    <script>
        (function () {
            var EXACT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                             ViewData["ExactPaymentModes"] as List<int> ?? new List<int>()));

            var mode = document.getElementById('PaymentModeID');
            var paid = document.getElementById('amountPaid');
            var helpCash = document.getElementById('amountPaidHelpCash');
            var helpExact = document.getElementById('amountPaidHelpExact');
            var exactTotal = document.getElementById('amountPaidExactTotal');
            if (!mode || !paid) { return; }

            // Lines are not editable on this form, but the discount is, so the
            // total moves and a locked figure has to follow it.
            var subTotal = @(Model.SubTotal.ToString(System.Globalization.CultureInfo.InvariantCulture));

            function total() {
                var discountField = document.getElementById('DiscountAmount');
                var taxField = document.getElementById('TaxAmount');
                var discount = discountField ? (parseFloat(discountField.value) || 0) : 0;
                var tax = taxField ? (parseFloat(taxField.value) || 0) : 0;
                return Math.max(0, subTotal - discount + tax);
            }

            function peso(v) {
                return '\u20B1' + v.toLocaleString(undefined,
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function apply() {
                var isExact = EXACT.indexOf(parseInt(mode.value, 10)) !== -1;

                if (isExact) {
                    var due = total();
                    paid.value = due.toFixed(2);
                    paid.readOnly = true;
                    paid.classList.add('bg-light');
                    if (exactTotal) { exactTotal.textContent = peso(due); }
                } else {
                    paid.readOnly = false;
                    paid.classList.remove('bg-light');
                }

                if (helpCash) { helpCash.classList.toggle('d-none', isExact); }
                if (helpExact) { helpExact.classList.toggle('d-none', !isExact); }
            }

            mode.addEventListener('change', apply);

            var discount = document.getElementById('DiscountAmount');
            if (discount) { discount.addEventListener('input', apply); }

            apply();
        })();
    </script>
    <script>
        (function () {
            var $customer = $('#CustomerID');
            var $vehicle = $('#VehicleID');
            var $jobOrder = $('#JobOrderID');

            function loadVehicles(customerId, selectedVehicleId) {
                $vehicle.prop('disabled', true).empty();

                if (!customerId) {
                    $vehicle.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("VehiclesForCustomer")', { customerId: customerId })
                    .done(function (data) {
                        $vehicle.empty();
                        if (!data.length) {
                            $vehicle.append($('<option></option>').val('').text('-- No vehicles for this customer --'));
                            return;
                        }
                        $vehicle.append($('<option></option>').val('').text('-- Select Vehicle --'));
                        $.each(data, function (i, v) {
                            var $opt = $('<option></option>').val(v.value).text(v.text);
                            if (selectedVehicleId && String(v.value) === String(selectedVehicleId)) {
                                $opt.prop('selected', true);
                            }
                            $vehicle.append($opt);
                        });
                        $vehicle.prop('disabled', false);

                        // Only one vehicle on file for this customer - skip
                        // making the user pick it themselves.
                        if (!selectedVehicleId && data.length === 1) {
                            $vehicle.val(data[0].value).trigger('change');
                        }
                    });
            }

            // Only Completed/Posted job orders for this customer that aren't
            // already invoiced elsewhere show up here (this invoice's own
            // job order is exempted from that check via excludeInvoiceId).
            function loadJobOrders(customerId, selectedJobOrderId) {
                $jobOrder.prop('disabled', true).empty();

                if (!customerId) {
                    $jobOrder.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("JobOrdersForCustomer")', { customerId: customerId, excludeInvoiceId: @Model.ServiceInvoiceID })
                    .done(function (data) {
                        $jobOrder.empty();
                        $jobOrder.append($('<option></option>').val('').text('-- None --'));
                        $.each(data, function (i, j) {
                            var $opt = $('<option></option>').val(j.value).text(j.text);
                            if (selectedJobOrderId && String(j.value) === String(selectedJobOrderId)) {
                                $opt.prop('selected', true);
                            }
                            $jobOrder.append($opt);
                        });
                        $jobOrder.prop('disabled', false);
                    });
            }

            $customer.on('change', function () {
                loadVehicles($(this).val(), null);
                loadJobOrders($(this).val(), null);
            });

            var startingCustomerId = $customer.val();
            if (startingCustomerId) {
                loadVehicles(startingCustomerId, '@Model.VehicleID');
                loadJobOrders(startingCustomerId, '@Model.JobOrderID');
            } else {
                $vehicle.prop('disabled', true);
                $jobOrder.prop('disabled', true);
            }
        })();
    </script>
}
