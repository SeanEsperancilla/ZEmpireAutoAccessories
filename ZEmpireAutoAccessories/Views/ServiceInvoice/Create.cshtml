@model ZEmpireAutoAccessories.Models.ServiceInvoice

@{
    ViewData["Title"] = "New Service Invoice";
    var fromJobOrderNumber = ViewData["FromJobOrderNumber"] as string;
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 4px; color:#0b0b0c; }
    .zx-page-sub { color:#7b8290; font-size:13.5px; margin:0 0 18px; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:24px; max-width:720px; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; display:inline-flex; align-items:center; gap:7px; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
</style>

<div class="zx-page-head">
    <h1>New Service Invoice</h1>
</div>
<p class="zx-page-sub">Create the invoice header, then add line items on the next screen.</p>

@if (!string.IsNullOrEmpty(fromJobOrderNumber))
{
    <div class="alert alert-info">
        Pre-filled from job order <strong>@fromJobOrderNumber</strong> — its line items will be copied over automatically once you save.
    </div>
}

<div class="zx-card">
    <form asp-action="Create" method="post" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerID" class="form-label"></label>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleID" class="form-label">Vehicle <span class="text-muted fw-normal">(optional)</span></label>
                <select asp-for="VehicleID" class="form-select" asp-items="ViewBag.VehicleID">
                    <option value="">-- None --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="JobOrderID" class="form-label">Job Order <span class="text-muted fw-normal">(optional)</span></label>
                <select asp-for="JobOrderID" class="form-select" asp-items="ViewBag.JobOrderID">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PaymentModeID" class="form-label"></label>
                <select asp-for="PaymentModeID" class="form-select" asp-items="ViewBag.PaymentModeID">
                    <option value="">-- Select Payment Mode --</option>
                </select>
                <span asp-validation-for="PaymentModeID" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Remarks" class="form-label">Remarks <span class="text-muted fw-normal">(optional)</span></label>
            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Save &amp; Add Line Items
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var $customer = $('#CustomerID');
            var $vehicle = $('#VehicleID');
            var $jobOrder = $('#JobOrderID');

            function loadVehicles(customerId, selectedVehicleId) {
                $vehicle.prop('disabled', true).empty();

                if (!customerId) {
                    $vehicle.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("VehiclesForCustomer")', { customerId: customerId })
                    .done(function (data) {
                        $vehicle.empty();
                        if (!data.length) {
                            $vehicle.append($('<option></option>').val('').text('-- No vehicles for this customer --'));
                            return;
                        }
                        $vehicle.append($('<option></option>').val('').text('-- Select Vehicle --'));
                        $.each(data, function (i, v) {
                            var $opt = $('<option></option>').val(v.value).text(v.text);
                            if (selectedVehicleId && String(v.value) === String(selectedVehicleId)) {
                                $opt.prop('selected', true);
                            }
                            $vehicle.append($opt);
                        });
                        $vehicle.prop('disabled', false);

                        // Only one vehicle on file for this customer - skip
                        // making the user pick it themselves.
                        if (!selectedVehicleId && data.length === 1) {
                            $vehicle.val(data[0].value).trigger('change');
                        }
                    });
            }

            // Only Completed/Posted job orders for this customer that aren't
            // already invoiced show up here - those are the only ones that
            // can actually be turned into an invoice.
            function loadJobOrders(customerId, selectedJobOrderId) {
                $jobOrder.prop('disabled', true).empty();

                if (!customerId) {
                    $jobOrder.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("JobOrdersForCustomer")', { customerId: customerId })
                    .done(function (data) {
                        $jobOrder.empty();
                        $jobOrder.append($('<option></option>').val('').text('-- None --'));
                        $.each(data, function (i, j) {
                            var $opt = $('<option></option>').val(j.value).text(j.text);
                            if (selectedJobOrderId && String(j.value) === String(selectedJobOrderId)) {
                                $opt.prop('selected', true);
                            }
                            $jobOrder.append($opt);
                        });
                        $jobOrder.prop('disabled', false);
                    });
            }

            $customer.on('change', function () {
                loadVehicles($(this).val(), null);
                loadJobOrders($(this).val(), null);
            });

            var startingCustomerId = $customer.val();
            if (startingCustomerId) {
                loadVehicles(startingCustomerId, '@Model.VehicleID');
                loadJobOrders(startingCustomerId, '@Model.JobOrderID');
            } else {
                $vehicle.prop('disabled', true);
                $jobOrder.prop('disabled', true);
            }
        })();
    </script>
}
