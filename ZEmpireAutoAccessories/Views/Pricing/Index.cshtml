@model IEnumerable<ZEmpireAutoAccessories.Models.Pricing>

@{
    ViewData["Title"] = "Pricing";
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .zx-actions a {
        margin-right: 10px;
        font-weight: 600;
        font-size: 13.5px;
    }
</style>

<div class="zx-page-head">
    <h1>Pricing</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Pricing</a>
</div>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Product</th>
                <th>Tint Variant</th>
                <th>Vehicle Classification</th>
                <th>Panel</th>
                <th>Price</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product.ProductName</td>
                    <td>@(item.TintVariant?.VariantName ?? "—")</td>
                    <td>@item.VehicleClassification.ClassificationName</td>
                    <td>@item.Panel.PanelName</td>
                    <td>@("₱" + item.Price.ToString("N2"))</td>
                    <td class="text-end pe-3 zx-actions">
                        <a asp-action="Edit" asp-route-id="@item.PricingID">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.PricingID">History</a>
                        <a asp-action="Delete" asp-route-id="@item.PricingID" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No pricing records yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>