@model IEnumerable<ZEmpireAutoAccessories.Models.Pricing>

@{
    ViewData["Title"] = "Pricing";
    var search = ViewData["Search"] as string;
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; overflow:hidden; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .zx-table td, .zx-table th { vertical-align:middle; }
    .icon-btn { width:32px; height:32px; display:inline-grid; place-items:center; border-radius:8px; border:1px solid #e8ebf0;
                background:#fff; color:#4b5563; margin-left:6px; transition:all .15s ease; text-decoration:none; }
    .icon-btn:hover { background:#0b0b0c; color:#fff; border-color:#0b0b0c; }
    .icon-btn.danger:hover { background:#dc2626; color:#fff; border-color:#dc2626; }
    .search-wrap { position:relative; max-width:420px; margin-bottom:10px; }
    .search-wrap svg { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:#98a0ad; }
    .search-input { padding-left:38px; border-radius:10px; }
    .search-actions { display:flex; gap:8px; margin-top:8px; margin-bottom:18px; }

    /* Three levels of grouping, set apart by indent, weight and background
       rather than by rules, so the depth reads at a glance without the table
       turning into a grid of boxes. */
    .grp td { border-bottom:none; }

    .grp-product td {
        background:#0f1115; color:#fff;
        padding-top:10px; padding-bottom:10px;
    }

    .grp-toggle {
        background:none; border:none; padding:0; color:#fff;
        font-weight:700; font-size:14px; letter-spacing:.2px;
        display:inline-flex; align-items:center; gap:8px; cursor:pointer;
    }

    .grp-caret { transition:transform .15s ease; flex:none; }
    .grp-toggle[aria-expanded="false"] .grp-caret { transform:rotate(-90deg); }

    .grp-count { color:#9aa3b2; font-size:12px; margin-left:10px; }

    .grp-variant td {
        background:#f2f4f7; font-weight:700; font-size:12px;
        text-transform:uppercase; letter-spacing:.4px; color:#4b5563;
        padding-left:34px !important;
    }

    .grp-panel td {
        background:#fafbfc; font-weight:600; font-size:12.5px; color:#6b7280;
        padding-left:58px !important;
    }

    .leaf { padding-left:82px !important; }
    .price-cell { font-variant-numeric:tabular-nums; font-weight:600; }

    @@media (max-width: 575.98px) {
        .grp-variant td { padding-left:20px !important; }
        .grp-panel td { padding-left:34px !important; }
        .leaf { padding-left:48px !important; }
    }
</style>

@* A price always belongs to a product, so it is set from the Products
   module (straight after creating one, or via "Set price" on the list).
   This screen is for changing a price that already exists. *@
<div class="zx-page-head">
    <h1>Pricing</h1>
    <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Go to Products to set a price</a>
</div>

<form asp-action="Index" method="get">
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        <input type="text" name="q" value="@search" class="form-control search-input" placeholder="Search product, tint variant, vehicle classification, or panel" />
    </div>
    <div class="search-actions">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Vehicle Classification</th>
                <th class="text-end">Price</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @* Product, variant and panel repeat down every row of a group -
               135 prices for one product means 135 identical "Black Series"
               cells. They become bands instead: product, then variant inside
               it, then panel inside that, with only the classification and
               price left on the row. Product bands collapse, since one
               product can fill the screen on its own. *@
            @{
                string? currentProduct = null, currentVariant = null, currentPanel = null;
                var productIndex = 0;

                // The catalogue runs to hundreds of prices - one product can be
                // 135 of them - so products start closed and you open the one
                // you want. A search is different: the rows that matched are
                // the point, so those come back open.
                var startCollapsed = string.IsNullOrEmpty(search);
                var hidden = startCollapsed ? "display:none" : null;

                // Row counts per product, so a collapsed band can say what is inside it.
                var perProduct = Model.GroupBy(p => p.Product.ProductName)
                                      .ToDictionary(g => g.Key, g => g.Count());
            }
            @foreach (var item in Model)
            {
                var variantName = item.TintVariant?.VariantName ?? "No tint variant";

                if (item.Product.ProductName != currentProduct)
                {
                    currentProduct = item.Product.ProductName;
                    currentVariant = null;
                    currentPanel = null;
                    productIndex++;

                    <tr class="grp grp-product" data-group="@productIndex">
                        <td colspan="3">
                            <button type="button" class="grp-toggle" aria-expanded="@(startCollapsed ? "false" : "true")">
                                <svg class="grp-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                                <span>@currentProduct</span>
                            </button>
                            <span class="grp-count">@perProduct[currentProduct] price@(perProduct[currentProduct] == 1 ? "" : "s")</span>
                        </td>
                    </tr>
                }

                if (variantName != currentVariant)
                {
                    currentVariant = variantName;
                    currentPanel = null;

                    <tr class="grp grp-variant" data-child-of="@productIndex" style="@hidden">
                        <td colspan="3">@currentVariant</td>
                    </tr>
                }

                if (item.Panel.PanelName != currentPanel)
                {
                    currentPanel = item.Panel.PanelName;

                    <tr class="grp grp-panel" data-child-of="@productIndex" style="@hidden">
                        <td colspan="3">@currentPanel</td>
                    </tr>
                }

                <tr data-child-of="@productIndex" style="@hidden">
                    <td class="leaf">@item.VehicleClassification.ClassificationName</td>
                    <td class="text-end price-cell">@("₱" + item.Price.ToString("N2"))</td>
                    <td class="text-end pe-3">
                        <a asp-action="Edit" asp-route-id="@item.PricingID" class="icon-btn" title="Edit">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.PricingID" class="icon-btn" title="Price history">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.PricingID" class="icon-btn danger" title="Delete">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(search) ? "No pricing records yet." : $"No pricing records match \"{search}\".")
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
    <script>
        // Collapse a product and everything under it. Rows carry the index of
        // the product band they belong to, so one pass hides the whole subtree
        // without needing to know how many variants or panels are inside.
        (function () {
            var table = document.querySelector('.zx-table');
            if (!table) { return; }

            table.addEventListener('click', function (e) {
                var toggle = e.target.closest('.grp-toggle');
                if (!toggle) { return; }

                var band = toggle.closest('tr');
                var group = band.dataset.group;
                var open = toggle.getAttribute('aria-expanded') !== 'false';

                toggle.setAttribute('aria-expanded', open ? 'false' : 'true');

                table.querySelectorAll('tr[data-child-of="' + group + '"]')
                     .forEach(function (row) { row.style.display = open ? 'none' : ''; });
            });
        })();
    </script>
}
