@model ZEmpireAutoAccessories.Models.Pricing

@{
    ViewData["Title"] = "Set Product Price";

    // Set when the form was opened for a specific product - from the Products
    // list or straight after creating one. There is no longer a way in that
    // does not name a product, so this is the normal case.
    var lockedProduct = ViewData["LockedProductName"] as string;
    var lockedCategory = ViewData["LockedProductCategory"] as string;
    var existingPrices = ViewData["ExistingPriceCount"] as int? ?? 0;
    var locked = !string.IsNullOrEmpty(lockedProduct);
    var saved = TempData["Success"] as string;
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .zx-page-sub {
        color: #7b8290;
        font-size: 13.5px;
        margin: 0 0 18px;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 640px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }
</style>

<div class="zx-page-head">
    <h1>Set Product Price</h1>
</div>
<p class="zx-page-sub">A price covers one classification and panel, so a product usually needs several.</p>

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success py-2 px-3" style="max-width:640px;">@saved</div>
}

<div class="zx-card">
    <form asp-action="Create" method="post" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        @if (locked)
        {
            <input type="hidden" asp-for="ProductID" />
            <div class="link-context mb-3">
                <div class="link-kind">Pricing</div>
                <div class="link-ref">@lockedProduct</div>
                <div class="link-item">@lockedCategory</div>
                <div class="link-customer">
                    @(existingPrices == 0
                        ? "No prices set for this product yet."
                        : $"{existingPrices} price{(existingPrices == 1 ? "" : "s")} already set.")
                </div>
                <a class="link-back" asp-controller="Product" asp-action="Index">Pick a different product</a>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label asp-for="ProductID" class="form-label"></label>
                <select asp-for="ProductID" class="form-select" asp-items="ViewBag.ProductID">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>
        }

        <div class="mb-3">
            <label asp-for="TintVariantID" class="form-label">Tint Variant <span class="text-muted fw-normal">(optional, for non-tint products leave blank)</span></label>
            @* Options are filled in by the script below, narrowed to the
               variants of the product that was picked. Rendering the full
               catalog here as well would flash every product's variants
               before the script trimmed them. *@
            <select asp-for="TintVariantID" class="form-select" disabled>
                <option value="">-- Select Product First --</option>
            </select>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleClassificationID" class="form-label"></label>
                <select asp-for="VehicleClassificationID" class="form-select" asp-items="ViewBag.VehicleClassificationID">
                    <option value="">-- Select Classification --</option>
                </select>
                <span asp-validation-for="VehicleClassificationID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PanelID" class="form-label"></label>
                <select asp-for="PanelID" class="form-select" asp-items="ViewBag.PanelID">
                    <option value="">-- Select Panel --</option>
                </select>
                <span asp-validation-for="PanelID" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
                Save
            </button>
            @if (locked)
            {
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Done</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Narrow Tint Variant to the product that was picked, and fill in
        // anything there is only one of. Setting a select's value in code
        // fires no event of its own, so each change is dispatched by hand
        // for anything listening further down the form.
        (function () {
            var variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["VariantsByProduct"]));
            var product = document.getElementById('ProductID');
            var tintVariant = document.getElementById('TintVariantID');
            if (!product || !tintVariant) { return; }

            var initialVariantId = '@(Model?.TintVariantID?.ToString() ?? "")';

            function setOptions(select, placeholder, items, selectedValue) {
                select.innerHTML = '';

                var blank = document.createElement('option');
                blank.value = '';
                blank.textContent = placeholder;
                select.appendChild(blank);

                items.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.name;
                    select.appendChild(option);
                });

                select.disabled = items.length === 0;

                // Exactly one to choose from - choose it, rather than making
                // someone open a dropdown with a single entry in it.
                if (items.length === 1) {
                    select.value = items[0].id;
                } else if (selectedValue) {
                    select.value = selectedValue;
                } else {
                    select.value = '';
                }

                select.dispatchEvent(new Event('change', { bubbles: true }));
            }

            function refreshVariants(selectedValue) {
                var productId = parseInt(product.value, 10);
                if (!productId) {
                    setOptions(tintVariant, '-- Select Product First --', [], null);
                    return;
                }

                var forProduct = variants.filter(function (v) {
                    return v.productId === productId;
                });

                // A product with no tint variants is priced per panel alone,
                // so leaving this blank is the correct answer, not an
                // unfinished field.
                setOptions(
                    tintVariant,
                    forProduct.length === 0 ? '-- None (product has no tint variants) --' : '-- None --',
                    forProduct,
                    selectedValue);
            }

            product.addEventListener('change', function () { refreshVariants(null); });

            // Single-option convenience for the two plain lists as well. They
            // are rendered server-side, so this only has to look at what is
            // already in the DOM: a placeholder plus exactly one real option.
            ['VehicleClassificationID', 'PanelID'].forEach(function (id) {
                var select = document.getElementById(id);
                if (!select || select.value) { return; }

                var real = Array.prototype.filter.call(select.options, function (o) { return o.value !== ''; });
                if (real.length === 1) {
                    select.value = real[0].value;
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });

            // Re-entering the form after a validation error: keep the product
            // that was chosen and restore the variant that went with it.
            refreshVariants(initialVariantId);
        })();
    </script>
}