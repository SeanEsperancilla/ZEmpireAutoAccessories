@model ZEmpireAutoAccessories.Models.Pricing

@{
    ViewData["Title"] = "Update Price";
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .zx-page-sub {
        color: #7b8290;
        font-size: 13.5px;
        margin: 0 0 18px;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 520px;
    }

    dt {
        color: #7b8290;
        font-weight: 600;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    dd {
        margin-bottom: 14px;
        font-size: 15px;
        color: #0b0b0c;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }
</style>

<div class="zx-page-head">
    <h1>Update Price</h1>
</div>
<p class="zx-page-sub">Changing the price is logged to this record's history automatically.</p>

<div class="zx-card">
    <dl class="row mb-3">
        <dt class="col-sm-4">Product</dt>
        <dd class="col-sm-8">@Model.Product.ProductName</dd>

        <dt class="col-sm-4">Tint Variant</dt>
        <dd class="col-sm-8">@(Model.TintVariant?.VariantName ?? "—")</dd>

        <dt class="col-sm-4">Classification</dt>
        <dd class="col-sm-8">@Model.VehicleClassification.ClassificationName</dd>

        <dt class="col-sm-4">Panel</dt>
        <dd class="col-sm-8">@Model.Panel.PanelName</dd>

        <dt class="col-sm-4">Current Price</dt>
        <dd class="col-sm-8">@("₱" + Model.Price.ToString("N2"))</dd>
    </dl>

    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@Model.PricingID" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label class="form-label">New Price</label>
            <input type="number" step="0.01" name="newPrice" class="form-control" value="@Model.Price" min="0" autofocus />
        </div>

        <button type="submit" class="btn btn-zx">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
            Save New Price
        </button>
        <a asp-action="Details" asp-route-id="@Model.PricingID" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>