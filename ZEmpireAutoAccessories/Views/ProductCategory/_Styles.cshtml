@*
    The page furniture shared by the four category screens, kept in one
    partial rather than copied into each - they are the same card, table and
    buttons, and four copies drift.
*@
<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 4px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .zx-page-sub {
        color: #7b8290;
        font-size: 13.5px;
        margin: 0 0 18px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-card.padded {
        padding: 24px;
        max-width: 640px;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .icon-btn {
        width: 32px;
        height: 32px;
        display: inline-grid;
        place-items: center;
        border-radius: 8px;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        margin-left: 6px;
        transition: all .15s ease;
        text-decoration: none;
    }

        .icon-btn:hover {
            background: #0b0b0c;
            color: #fff;
            border-color: #0b0b0c;
        }

        .icon-btn.danger:hover {
            background: #dc2626;
            color: #fff;
            border-color: #dc2626;
        }
</style>
