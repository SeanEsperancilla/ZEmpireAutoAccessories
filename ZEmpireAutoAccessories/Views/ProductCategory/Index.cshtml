@model IEnumerable<ZEmpireAutoAccessories.Models.ProductCategory>

@{
    ViewData["Title"] = "Product Categories";

    var counts = ViewData["ProductCount"] as Dictionary<int, int> ?? new Dictionary<int, int>();
    var byLength = ViewData["SoldByLength"] as HashSet<int> ?? new HashSet<int>();
    var saved = TempData["Success"] as string;
}

<partial name="_Styles" />

<div class="zx-page-head">
    <h1>Product Categories</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Products</a>
        <a class="btn btn-zx" asp-action="Create">+ New Category</a>
    </div>
</div>
<p class="zx-page-sub">
    The shelves products are filed under, and how each one is measured.
</p>

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success py-2 px-3">@saved</div>
}

<div class="zx-card">
    <div class="table-responsive">
        <table class="table zx-table mb-0">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Measured by</th>
                    <th class="text-end">Products</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var count = counts.TryGetValue(item.CategoryID, out var c) ? c : 0;
                    var canonical = ZEmpireAutoAccessories.Models.ProductCategories
                        .Canonical(item.CategoryName);

                    <tr>
                        <td>
                            @item.CategoryName
                            @if (ZEmpireAutoAccessories.Models.ProductCategories.IsDuplicate(item.CategoryName))
                            {
                                @* Two names for one shelf. The other screens already
                                   fold them together; say so here rather than leaving
                                   someone to wonder why this one is not offered on the
                                   product form. *@
                                <span class="measured-help d-block">
                                    Shown everywhere as &ldquo;@canonical&rdquo;, and not offered on the product form.
                                </span>
                            }
                        </td>
                        <td>
                            @if (byLength.Contains(item.CategoryID))
                            {
                                <span class="measured-pill is-length">By length</span>
                            }
                            else
                            {
                                <span class="measured-pill is-count">By piece</span>
                            }
                        </td>
                        <td class="text-end">@count</td>
                        <td class="text-end pe-3">
                            <a asp-action="Edit" asp-route-id="@item.CategoryID" class="icon-btn" title="Edit">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryID" class="icon-btn danger" title="Delete">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No categories yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
