@model ZEmpireAutoAccessories.Models.ProductCategory

@{
    ViewData["Title"] = "Delete Category";

    var blockReason = ViewData["BlockReason"] as string;
    var deleteError = TempData["DeleteError"] as string;
    var blocked = !string.IsNullOrEmpty(blockReason) || !string.IsNullOrEmpty(deleteError);
}

<partial name="_Styles" />

<div class="zx-page-head">
    <h1>Delete Category</h1>
</div>

@if (!string.IsNullOrEmpty(deleteError))
{
    <div class="alert alert-danger">@deleteError</div>
}
else if (!string.IsNullOrEmpty(blockReason))
{
    <div class="alert alert-danger">@blockReason</div>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete this category? This cannot be undone.
    </div>
}

<div class="zx-card padded">
    <dl class="row mb-0">
        <dt class="col-sm-4">Category name</dt>
        <dd class="col-sm-8">@Model.CategoryName</dd>
    </dl>
</div>

<div class="mt-3">
    @if (blocked)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    }
    else
    {
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="CategoryID" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div>
