@model ZEmpireAutoAccessories.Models.CashieringViewModel

@{
    ViewData["Title"] = "Cashiering";
    var today = DateOnly.FromDateTime(DateTime.Now);
    var isToday = Model.DateFrom == today && Model.DateTo == today;

    // Cashiering has no module of its own - it is opened by holding Sales or
    // Service Invoices, and the controller has already limited the rows to
    // the half the user holds. The same two flags decide which tiles,
    // filters and links are worth showing.
    var canOpenSales = Model.CanSeeSales;
    var canOpenInvoices = Model.CanSeeServiceInvoices;
    var seesBothSources = canOpenSales && canOpenInvoices;

    // Collected on a bank transfer or a QRPH payment with no receipt against
    // it. These are the rows to chase before the day is closed out.
    var unproven = Model.Transactions.Count(t => t.ProofMissing);
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .zx-range {
        font-size: 13px;
        color: #7b8290;
        font-weight: 500;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    /* ----- summary tiles ----- */
    .tile-row {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .tile {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 16px 18px;
    }

        .tile .label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .4px;
            color: #7b8290;
            font-weight: 600;
        }

        .tile .value {
            font-family: 'Oswald',system-ui,sans-serif;
            font-size: 26px;
            font-weight: 700;
            color: #0b0b0c;
            margin-top: 4px;
            line-height: 1.1;
        }

        .tile .sub {
            font-size: 12px;
            color: #7b8290;
            margin-top: 2px;
        }

        .tile.grand {
            background: #0b0b0c;
            border-color: #0b0b0c;
        }

            .tile.grand .label {
                color: #9aa1ad;
            }

            .tile.grand .value {
                color: #fff;
            }

            .tile.grand .sub {
                color: #9aa1ad;
            }

        .tile.warn .value {
            color: #b45309;
        }

    /* ----- filters ----- */
    .filter-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 16px 18px;
        margin-bottom: 20px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(170px,1fr));
        gap: 12px;
        align-items: end;
    }

    .filter-grid label {
        font-size: 12px;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 4px;
        display: block;
    }

    .quick-links {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .quick-pill {
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        transition: all .15s ease;
    }

        .quick-pill:hover {
            border-color: #c7ccd6;
            color: #0b0b0c;
        }

        .quick-pill.active {
            background: #0b0b0c;
            color: #fff;
            border-color: transparent;
        }

    /* ----- badges ----- */
    .badge-paid {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-pending {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }

    .badge-cancelled {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .badge-refunded {
        background: rgba(245,158,11,.15);
        color: #b45309;
        font-weight: 600;
    }

    .src-tag {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .src-sale {
        background: rgba(59,130,246,.14);
        color: #1d4ed8;
    }

    .src-invoice {
        background: rgba(168,85,247,.14);
        color: #7e22ce;
    }

    .row-uncollected td {
        background: #fcfcfd;
        color: #9aa1ad;
    }

    .proof-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .proof-attached { background: #ecfdf3; color: #15803d; border-color: #bbf7d0; }
    .proof-attached:hover { background: #d6f5e3; color: #14532d; }
    .proof-missing { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
    .proof-missing:hover { background: #fde2e2; color: #7f1d1d; }
    .proof-none { color: #c4c9d2; font-size: 12px; }
    .proof-pair { display: inline-flex; align-items: center; gap: 4px; }

    .proof-remove {
        border: none;
        background: none;
        padding: 2px 3px;
        line-height: 0;
        color: #c4c9d2;
        border-radius: 5px;
    }

    .proof-remove:hover { color: #b91c1c; background: #fef2f2; }

    .icon-btn {
        width: 32px;
        height: 32px;
        display: inline-grid;
        place-items: center;
        border-radius: 8px;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        transition: all .15s ease;
        text-decoration: none;
    }

        .icon-btn:hover {
            background: #0b0b0c;
            color: #fff;
            border-color: #0b0b0c;
        }

    .breakdown-table td, .breakdown-table th {
        padding: .6rem .75rem;
        font-size: 13.5px;
    }

    /* Counts and pesos line up digit under digit, so two rows can be compared
       at a glance instead of read. */
    .breakdown-table .num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .breakdown-table .amount { font-weight: 600; color: #0b0b0c; }

    .breakdown-table tfoot td {
        border-top: 2px solid #e8ebf0;
        font-weight: 700;
        color: #0b0b0c;
    }

    .breakdown-head {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 15px;
        padding: 14px 18px 0;
        margin: 0;
        color: #0b0b0c;
    }

    .breakdown-sub {
        padding: 2px 18px 0;
        margin: 0;
        color: #7b8290;
        font-size: 12.5px;
    }
</style>

@if (TempData["Success"] is string proofSuccess)
{
    <div class="alert alert-success">@proofSuccess</div>
}
@if (TempData["ProofError"] is string proofError)
{
    <div class="alert alert-danger">@proofError</div>
}
@if (unproven > 0)
{
    <div class="alert alert-warning">
        <strong>@unproven payment@(unproven == 1 ? "" : "s")</strong>
        in this range came in online with no receipt attached.
        Attach what the customer sent, from the Proof column below.
    </div>
}

<div class="zx-page-head">
    <div>
        <h1>Cashiering</h1>
        <div class="zx-range">
            @if (isToday)
            {
                <text>Today &middot; @Model.DateFrom.ToString("MMM d, yyyy")</text>
            }
            else if (Model.DateFrom == Model.DateTo)
            {
                <text>@Model.DateFrom.ToString("MMM d, yyyy")</text>
            }
            else
            {
                <text>@Model.DateFrom.ToString("MMM d, yyyy") &ndash; @Model.DateTo.ToString("MMM d, yyyy")</text>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (canOpenSales)
        {
            <a class="btn btn-outline-dark" asp-controller="Sales" asp-action="Create">+ New Sale</a>
        }
        @if (canOpenInvoices)
        {
            <a class="btn btn-zx" asp-controller="ServiceInvoice" asp-action="Create">+ New Service Invoice</a>
        }
        @* The other way round: this screen is today at the counter, the
           report is the same figures over a period, with a PDF to keep. *@
        @if (User.HasClaim(AppClaims.ModuleAccess, "Reports"))
        {
            <a class="btn btn-outline-secondary"
               asp-controller="Report" asp-action="Collections"
               asp-route-from="@Model.DateFrom.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.DateTo.ToString("yyyy-MM-dd")">
                Collections report
            </a>
        }
    </div>
</div>

@* The day's takings are Admin-only. The controller has already zeroed
   these for anyone else, so this is what they read, not a second gate. *@
@if (Model.CanSeeTotals)
{
    <div class="tile-row">
        <div class="tile grand">
            <div class="label">Total Collected</div>
            <div class="value">@("₱" + Model.GrandTotal.ToString("N2"))</div>
            <div class="sub">@Model.CollectedCount transaction@(Model.CollectedCount == 1 ? "" : "s")</div>
        </div>
        @* Output VAT for the period. Prices are quoted VAT-inclusive, so this
           is the 12% already inside what was collected, not an extra charge -
           see Models/Vat.cs. *@
        <div class="tile">
            <div class="label">VAT (@Vat.RateLabel)</div>
            <div class="value">@("₱" + Vat.Amount(Model.GrandTotal).ToString("N2"))</div>
            <div class="sub">included in the collected total</div>
        </div>
        @if (canOpenSales)
        {
            <div class="tile">
                <div class="label">Product Sales</div>
                <div class="value">@("₱" + Model.SalesTotal.ToString("N2"))</div>
                <div class="sub">from sales.Sales</div>
            </div>
        }
        @if (canOpenInvoices)
        {
            <div class="tile">
                <div class="label">Service Invoices</div>
                <div class="value">@("₱" + Model.ServiceInvoiceTotal.ToString("N2"))</div>
                <div class="sub">paid invoices only</div>
            </div>
        }
        <div class="tile warn">
            <div class="label">Not Collected</div>
            <div class="value">@("₱" + Model.UncollectedTotal.ToString("N2"))</div>
            <div class="sub">@Model.UncollectedCount pending / cancelled / refunded</div>
        </div>
    </div>
}

<div class="filter-card">
    <form asp-action="Index" method="get">
        <div class="filter-grid">
            <div>
                <label for="from">From</label>
                <input type="date" id="from" name="from" class="form-control"
                       value="@(Model.DateFrom.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label for="to">To</label>
                <input type="date" id="to" name="to" class="form-control"
                       value="@(Model.DateTo.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label for="q">Search</label>
                <input type="text" id="q" name="q" class="form-control"
                       placeholder="Invoice # or customer" value="@Model.Search" />
            </div>
            <div>
                <label for="paymentModeId">Payment Mode</label>
                <select id="paymentModeId" name="paymentModeId" class="form-select"
                        asp-items="ViewBag.PaymentModeID">
                    <option value="">All</option>
                </select>
            </div>
            <div>
                <label for="userId">Cashier</label>
                <select id="userId" name="userId" class="form-select" asp-items="ViewBag.UserId">
                    <option value="">All</option>
                </select>
            </div>
            @if (seesBothSources)
            {
                <div>
                    <label for="source">Type</label>
                    <select id="source" name="source" class="form-select">
                        <option value="">All</option>
                        <option value="@CashierSource.Sale" selected="@(Model.Source == CashierSource.Sale)">Product Sales</option>
                        <option value="@CashierSource.ServiceInvoice" selected="@(Model.Source == CashierSource.ServiceInvoice)">Service Invoices</option>
                    </select>
                </div>
            }
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-zx flex-grow-1">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </form>

    <div class="quick-links">
        <a asp-action="Index"
           class="quick-pill @(isToday ? "active" : "")">Today</a>
        <a asp-action="Index"
           asp-route-from="@(today.AddDays(-1).ToString("yyyy-MM-dd"))"
           asp-route-to="@(today.AddDays(-1).ToString("yyyy-MM-dd"))"
           class="quick-pill">Yesterday</a>
        <a asp-action="Index"
           asp-route-from="@(today.AddDays(-6).ToString("yyyy-MM-dd"))"
           asp-route-to="@(today.ToString("yyyy-MM-dd"))"
           class="quick-pill">Last 7 days</a>
        <a asp-action="Index"
           asp-route-from="@(new DateOnly(today.Year, today.Month, 1).ToString("yyyy-MM-dd"))"
           asp-route-to="@(today.ToString("yyyy-MM-dd"))"
           class="quick-pill">This month</a>
    </div>
</div>

@* Also Admin-only: these are the same takings split up, and they add
   back to the Total Collected above. *@
@if (Model.CanSeeTotals && (Model.ByPaymentMode.Count > 0 || Model.ByCashier.Count > 0))
{
    // Summed from the rows on show rather than read off the tiles above, so a
    // footer can never disagree with the lines it sits under.
    var modeTransactions = Model.ByPaymentMode.Sum(m => m.TransactionCount);
    var modeTotal = Model.ByPaymentMode.Sum(m => m.Total);
    var cashierTransactions = Model.ByCashier.Sum(c => c.TransactionCount);
    var cashierTotal = Model.ByCashier.Sum(c => c.Total);

    <div class="row g-3 mb-3">
        @if (Model.ByPaymentMode.Count > 0)
        {
            <div class="col-md-6">
                <div class="zx-card h-100">
                    <h2 class="breakdown-head">Collected by Payment Mode</h2>
                    <p class="breakdown-sub">How the money came in. Collected transactions only.</p>
                    <table class="table breakdown-table mb-0">
                        <thead>
                            <tr>
                                <th>Mode</th>
                                @* "Txns" saved five characters in a column
                                   with room to spare, at the cost of anyone
                                   knowing what it counted. *@
                                <th class="num">Transactions</th>
                                <th class="num pe-3">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mode in Model.ByPaymentMode)
                            {
                                <tr>
                                    <td>@mode.PaymentModeName</td>
                                    <td class="num">@mode.TransactionCount.ToString("N0")</td>
                                    <td class="num amount pe-3">@("₱" + mode.Total.ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        @* The rows add up to the Total Collected tile above.
                           Footed here so that can be seen rather than taken on
                           trust. *@
                        @* A total under a single line only repeats it. *@
                        @if (Model.ByPaymentMode.Count > 1)
                        {
                        <tfoot>
                            <tr>
                                <td>All modes</td>
                                <td class="num">@modeTransactions.ToString("N0")</td>
                                <td class="num pe-3">@("₱" + modeTotal.ToString("N2"))</td>
                            </tr>
                        </tfoot>
                        }
                    </table>
                </div>
            </div>
        }
        @if (Model.ByCashier.Count > 0)
        {
            <div class="col-md-6">
                <div class="zx-card h-100">
                    <h2 class="breakdown-head">Collected by Cashier</h2>
                    <p class="breakdown-sub">Who took it. The same transactions, counted another way.</p>
                    <table class="table breakdown-table mb-0">
                        <thead>
                            <tr>
                                <th>Cashier</th>
                                <th class="num">Transactions</th>
                                <th class="num pe-3">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cashier in Model.ByCashier)
                            {
                                <tr>
                                    <td>@(cashier.CashierName ?? "—")</td>
                                    <td class="num">@cashier.TransactionCount.ToString("N0")</td>
                                    <td class="num amount pe-3">@("₱" + cashier.Total.ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.ByCashier.Count > 1)
                        {
                        <tfoot>
                            <tr>
                                <td>Everyone</td>
                                <td class="num">@cashierTransactions.ToString("N0")</td>
                                <td class="num pe-3">@("₱" + cashierTotal.ToString("N2"))</td>
                            </tr>
                        </tfoot>
                        }
                    </table>
                </div>
            </div>
        }
    </div>
}

<div class="zx-card">
    <div class="table-responsive">
        <table class="table zx-table mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Invoice #</th>
                    <th>Date &amp; Time</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Payment</th>
                    <th>Cashier</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Tendered</th>
                    <th class="text-end">Change</th>
                    <th>Status</th>
                    <th>Proof</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in Model.Transactions)
                {
                    var isSale = txn.Source == CashierSource.Sale;
                    var openController = isSale ? "Sales" : "ServiceInvoice";
                    var openTitle = isSale ? "Open sale" : "Open service invoice";
                    var printTitle = isSale ? "Reprint sales receipt" : "Reprint service invoice";
                    var canOpen = isSale ? canOpenSales : canOpenInvoices;
                    <tr class="@(txn.IsCollected ? "" : "row-uncollected")">
                        <td>
                            <span class="src-tag @(isSale ? "src-sale" : "src-invoice")">
                                @(isSale ? "Sale" : "Service")
                            </span>
                        </td>
                        <td>@txn.InvoiceNumber</td>
                        <td>@txn.TransactionDate.ToString("MMM d, yyyy h:mm tt")</td>
                        <td>@(txn.CustomerName ?? "—")</td>
                        <td>@(txn.PlateNumber ?? "—")</td>
                        <td>@txn.PaymentModeName</td>
                        <td>@(txn.CashierName ?? "—")</td>
                        <td class="text-end">@("₱" + txn.TotalAmount.ToString("N2"))</td>
                        <td class="text-end">
                            @(txn.AmountPaid.HasValue ? "₱" + txn.AmountPaid.Value.ToString("N2") : "—")
                        </td>
                        <td class="text-end">
                            @(txn.ChangeAmount.HasValue ? "₱" + txn.ChangeAmount.Value.ToString("N2") : "—")
                        </td>
                        <td><span class="badge badge-@txn.Status.ToLower()">@txn.Status</span></td>
                        @* Cash and card are settled in front of you. A bank
                           transfer or a QRPH payment is a claim until the
                           receipt is attached, so those rows say so. *@
                        <td>
                            @if (txn.HasProof)
                            {
                                <span class="proof-pair">
                                    <a class="proof-chip proof-attached"
                                       asp-action="Proof"
                                       asp-route-source="@txn.Source"
                                       asp-route-sourceId="@txn.SourceId"
                                       target="_blank"
                                       title="View the attached receipt">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.234 20.252 21 12.3"/><path d="m16 6-8.414 8.586a2 2 0 0 0 0 2.828 2 2 0 0 0 2.828 0l8.414-8.586a4 4 0 0 0 0-5.656 4 4 0 0 0-5.656 0l-8.415 8.585a6 6 0 1 0 8.486 8.486"/></svg>
                                        Attached
                                    </a>
                                    @if (canOpen)
                                    {
                                        @* The wrong file happens - the other
                                           receipt, the screenshot taken before
                                           it finished sending. Removing puts
                                           the row back to asking for one. *@
                                        <form asp-action="RemoveProof" method="post" class="d-inline"
                                              onsubmit="return confirm('Remove the file attached to @txn.InvoiceNumber? This payment will show as missing its proof again.');">
                                            <input type="hidden" name="source" value="@txn.Source" />
                                            <input type="hidden" name="sourceId" value="@txn.SourceId" />
                                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                            <button type="submit" class="proof-remove" title="Remove this file">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            </button>
                                        </form>
                                    }
                                </span>
                            }
                            else if (txn.NeedsProof && canOpen)
                            {
                                <button type="button" class="proof-chip proof-missing attach-proof"
                                        data-source="@txn.Source"
                                        data-source-id="@txn.SourceId"
                                        data-invoice="@txn.InvoiceNumber"
                                        data-mode="@txn.PaymentModeName">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                                    Attach
                                </button>
                            }
                            else if (txn.NeedsProof)
                            {
                                <span class="proof-none">Missing</span>
                            }
                            else
                            {
                                <span class="proof-none">&mdash;</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            @if (canOpen)
                            {
                                @* Regenerates the PDF from the document as it
                                   stands now, so a reprint shows any later
                                   correction rather than a stored copy. *@
                                <a class="icon-btn"
                                   asp-controller="@openController"
                                   asp-action="Pdf"
                                   asp-route-id="@txn.SourceId"
                                   title="@printTitle"
                                   target="_blank">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
                                </a>
                                <a class="icon-btn"
                                   asp-controller="@openController"
                                   asp-action="Details"
                                   asp-route-id="@txn.SourceId"
                                   title="@openTitle">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Transactions.Count == 0)
                {
                    <tr>
                        <td colspan="13" class="text-center text-muted py-4">
                            No sales or service invoices in this range.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* One dialog for the whole table - the row's details are written into it
   when its Attach button is pressed, rather than rendering a form per row. *@
<div class="modal fade" id="attachProofModal" tabindex="-1" aria-hidden="true" aria-labelledby="attachProofTitle">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="AttachProof" method="post" enctype="multipart/form-data" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="source" id="proofSource" />
            <input type="hidden" name="sourceId" id="proofSourceId" />
            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

            <div class="modal-header">
                <h5 class="modal-title" id="attachProofTitle">Attach proof of payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="mb-3" id="proofFor"></p>
                <label class="form-label" for="proofFile">Receipt or screenshot</label>
                <input type="file" class="form-control" id="proofFile" name="proof"
                       accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" required />
                <div class="form-text">
                    JPG, PNG, WEBP or PDF, up to 5 MB. Attaching a new file replaces the one already there.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-zx">Attach</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalElement = document.getElementById('attachProofModal');
            if (!modalElement) { return; }

            var modal = new bootstrap.Modal(modalElement);

            document.querySelectorAll('.attach-proof').forEach(function (button) {
                button.addEventListener('click', function () {
                    document.getElementById('proofSource').value = button.dataset.source;
                    document.getElementById('proofSourceId').value = button.dataset.sourceId;
                    document.getElementById('proofFor').textContent =
                        button.dataset.invoice + ' was paid by ' + button.dataset.mode +
                        '. Attach what the customer sent.';

                    // A file input keeps its last selection; clear it so the
                    // dialog never opens holding the previous row's receipt.
                    document.getElementById('proofFile').value = '';
                    modal.show();
                });
            });
        })();
    </script>
}
