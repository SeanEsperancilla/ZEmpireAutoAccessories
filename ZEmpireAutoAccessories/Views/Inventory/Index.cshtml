@model IEnumerable<ZEmpireAutoAccessories.Models.VwStockOnHand>

@{
    ViewData["Title"] = "Inventory";
    const decimal lowStockThreshold = 5;
    var currentStatus = ViewData["Status"] as string;
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0;
        color: #0b0b0c;
    }

    .status-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

        .status-filters a {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            color: #4b5563;
            background: #fff;
            border: 1px solid #e8ebf0;
            text-decoration: none;
        }

            .status-filters a.active, .status-filters a:hover {
                background: #0b0b0c;
                color: #fff;
                border-color: #0b0b0c;
            }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .badge-in {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-low {
        background: rgba(245,158,11,.15);
        color: #b45309;
        font-weight: 600;
    }

    .badge-out {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .icon-btn {
        width: 32px;
        height: 32px;
        display: inline-grid;
        place-items: center;
        border-radius: 8px;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        transition: all .15s ease;
        text-decoration: none;
    }

        .icon-btn:hover {
            background: #0b0b0c;
            color: #fff;
            border-color: #0b0b0c;
        }
</style>

<style>
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
</style>

<div class="zx-page-head">
    <h1>Inventory</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-controller="InventoryCheck" asp-action="Index">Stock counts</a>
        <a class="btn btn-zx" asp-controller="InventoryCheck" asp-action="Create">+ New stock count</a>
    </div>
</div>

<div class="status-filters">
    <a asp-action="Index" class="@(string.IsNullOrEmpty(currentStatus) ? "active" : "")">All</a>
    <a asp-action="Index" asp-route-status="InStock" class="@(currentStatus == "InStock" ? "active" : "")">In Stock</a>
    <a asp-action="Index" asp-route-status="LowStock" class="@(currentStatus == "LowStock" ? "active" : "")">Low Stock</a>
    <a asp-action="Index" asp-route-status="OutOfStock" class="@(currentStatus == "OutOfStock" ? "active" : "")">Out of Stock</a>
</div>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Product</th>
                <th>Stock On Hand</th>
                <th>Status</th>
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var stock = item.StockOnHand ?? 0;
                <tr>
                    <td>@item.ProductName</td>
                    <td>@stock.ToString("N0")</td>
                    <td>
                        @if (stock <= 0)
                        {
                            <span class="badge badge-out">Out of Stock</span>
                        }
                        else if (stock <= lowStockThreshold)
                        {
                            <span class="badge badge-low">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge badge-in">In Stock</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        <a asp-action="Details" asp-route-id="@item.ProductID" class="icon-btn" title="Manage stock">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1" /><path d="M4 8v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8" /><path d="M10 12h4" /></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No products yet.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
