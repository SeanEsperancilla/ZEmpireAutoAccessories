@model IEnumerable<ZEmpireAutoAccessories.Models.VwStockOnHand>

@{
    ViewData["Title"] = "Inventory";
    const decimal lowStockThreshold = 5;
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 18px;
        color: #0b0b0c;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .badge-ok {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-low {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }
</style>

<div class="zx-page-head">
    <h1>Inventory</h1>
</div>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Product</th>
                <th>Stock On Hand</th>
                <th>Status</th>
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var stock = item.StockOnHand ?? 0;
                <tr>
                    <td>@item.ProductName</td>
                    <td>@stock</td>
                    <td>
                        @if (stock <= lowStockThreshold)
                        {
                            <span class="badge badge-low">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge badge-ok">OK</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        <a asp-action="Details" asp-route-id="@item.ProductID">Manage Stock</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No products yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>