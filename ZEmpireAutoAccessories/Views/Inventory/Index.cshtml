@model IEnumerable<ZEmpireAutoAccessories.Models.VwStockOnHand>

@{
    ViewData["Title"] = "Inventory";
    const decimal lowStockThreshold = 5;
    var currentStatus = ViewData["Status"] as string;
    var search = ViewData["Search"] as string;

    var countAll = ViewData["CountAll"] as int? ?? 0;
    var countIn = ViewData["CountIn"] as int? ?? 0;
    var countLow = ViewData["CountLow"] as int? ?? 0;
    var countOut = ViewData["CountOut"] as int? ?? 0;

    var success = TempData["Success"] as string;
    var inventoryError = TempData["InventoryError"] as string;
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0;
        color: #0b0b0c;
    }

    .status-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

        .status-filters a {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            color: #4b5563;
            background: #fff;
            border: 1px solid #e8ebf0;
            text-decoration: none;
        }

            .status-filters a.active, .status-filters a:hover {
                background: #0b0b0c;
                color: #fff;
                border-color: #0b0b0c;
            }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .badge-in {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-low {
        background: rgba(245,158,11,.15);
        color: #b45309;
        font-weight: 600;
    }

    .badge-out {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .icon-btn {
        width: 32px;
        height: 32px;
        display: inline-grid;
        place-items: center;
        border-radius: 8px;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        transition: all .15s ease;
        text-decoration: none;
    }

        .icon-btn:hover {
            background: #0b0b0c;
            color: #fff;
            border-color: #0b0b0c;
        }
</style>

<style>
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }

    .zx-page-sub { color:#7b8290; font-size:13.5px; margin:-8px 0 18px; }

    .search-wrap { position:relative; max-width:420px; margin-bottom:14px; }
    .search-wrap svg { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:#98a0ad; }
    .search-input { padding-left:38px; border-radius:10px; }
    .search-actions { display:flex; gap:8px; margin-bottom:18px; }

    /* Count beside each filter, so "4 low" is visible without clicking in. */
    .status-filters .tab-count {
        display:inline-block; margin-left:7px; padding:1px 7px; border-radius:999px;
        font-size:11.5px; background:rgba(0,0,0,.07);
    }
    .status-filters a.active .tab-count { background:rgba(255,255,255,.22); }

    /* Move stock straight from the row rather than opening the product. */
    .move-form { display:flex; gap:6px; justify-content:flex-end; align-items:center; }
    .move-qty { width:86px; }
    .move-form .btn { padding:4px 10px; font-weight:600; }

    /* On a phone the four columns plus a quantity box and two buttons are
       wider than the screen, which pushes the buttons out of reach inside the
       table's own sideways scroll. Tighten the row so the whole thing fits
       without scrolling. */
    @@media (max-width: 575.98px) {
        .zx-table td, .zx-table th { padding-left:.4rem; padding-right:.4rem; font-size:12.5px; }
        .move-form { gap:4px; }
        .move-qty { width:54px; }
        .move-form .btn { padding:3px 7px; font-size:12px; }
        .move-form .icon-btn { display:none; }

        /* The stock figure and the filter tabs already say whether a product
           is low or out, so the badge column earns its space back for the
           In/Out buttons. */
        .status-col { display:none; }
        .move-qty { width:48px; }
    }
</style>

<div class="zx-page-head">
    <h1>Inventory</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-controller="InventoryCheck" asp-action="Index">Stock counts</a>
        <a class="btn btn-zx" asp-controller="InventoryCheck" asp-action="Create">+ New stock count</a>
    </div>
</div>
<p class="zx-page-sub">
    Stock in or out straight from a row when you know the movement. Use a stock count when you want to
    check the whole shelf against the system and correct whatever is off.
</p>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success py-2 px-3">@success</div>
}
@if (!string.IsNullOrEmpty(inventoryError))
{
    <div class="alert alert-danger py-2 px-3">@inventoryError</div>
}

<form asp-action="Index" method="get">
    @* Keep the tab you are on while searching within it. *@
    <input type="hidden" name="status" value="@currentStatus" />
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        <input type="text" name="q" value="@search" class="form-control search-input" placeholder="Search product" />
    </div>
    <div class="search-actions">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" asp-route-status="@currentStatus" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

<div class="status-filters">
    <a asp-action="Index" asp-route-q="@search" class="@(string.IsNullOrEmpty(currentStatus) ? "active" : "")">All <span class="tab-count">@countAll</span></a>
    <a asp-action="Index" asp-route-status="InStock" asp-route-q="@search" class="@(currentStatus == "InStock" ? "active" : "")">In Stock <span class="tab-count">@countIn</span></a>
    <a asp-action="Index" asp-route-status="LowStock" asp-route-q="@search" class="@(currentStatus == "LowStock" ? "active" : "")">Low Stock <span class="tab-count">@countLow</span></a>
    <a asp-action="Index" asp-route-status="OutOfStock" asp-route-q="@search" class="@(currentStatus == "OutOfStock" ? "active" : "")">Out of Stock <span class="tab-count">@countOut</span></a>
</div>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Product</th>
                <th>Stock<span class="d-none d-sm-inline"> On Hand</span></th>
                <th class="status-col">Status</th>
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var stock = item.StockOnHand ?? 0;
                <tr>
                    <td>@item.ProductName</td>
                    <td>@stock.ToString("N0")</td>
                    <td class="status-col">
                        @if (stock <= 0)
                        {
                            <span class="badge badge-out">Out of Stock</span>
                        }
                        else if (stock <= lowStockThreshold)
                        {
                            <span class="badge badge-low">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge badge-in">In Stock</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        @* One form, two submit buttons: the Out button posts to
                           the other action through formaction, so a row needs
                           only a single quantity box. *@
                        <form asp-action="StockIn" method="post" class="move-form">
                            <input type="hidden" name="productId" value="@item.ProductID" />
                            <input type="hidden" name="returnTo" value="index" />
                            <input type="hidden" name="status" value="@currentStatus" />
                            <input type="hidden" name="q" value="@search" />
                            <input type="number" name="quantity" step="0.01" min="0.01"
                                   class="form-control form-control-sm move-qty" placeholder="Qty" />
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Stock in">In</button>
                            @* Stocking out of an empty shelf can only be
                               refused, so don't offer the click. *@
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    formaction="@Url.Action("StockOut")"
                                    disabled="@(stock <= 0)"
                                    title="@(stock <= 0 ? "Nothing in stock to take out" : "Stock out")">Out</button>
                            <a asp-action="Details" asp-route-id="@item.ProductID" class="icon-btn" title="History and details">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1" /><path d="M4 8v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8" /><path d="M10 12h4" /></svg>
                            </a>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(search) ? "No products yet." : $"No product matches \"{search}\".")
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
