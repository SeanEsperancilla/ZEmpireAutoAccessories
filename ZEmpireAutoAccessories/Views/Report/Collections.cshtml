@model ZEmpireAutoAccessories.Models.CashieringViewModel

@{
    ViewData["Title"] = "Collections Report";
    var from = ViewData["From"] as DateOnly?;
    var to = ViewData["To"] as DateOnly?;

    var modeTransactions = Model.ByPaymentMode.Sum(m => m.TransactionCount);
    var modeTotal = Model.ByPaymentMode.Sum(m => m.Total);
    var cashierTransactions = Model.ByCashier.Sum(c => c.TransactionCount);
    var cashierTotal = Model.ByCashier.Sum(c => c.Total);
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 18px; color:#0b0b0c; }
    .report-tabs { display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
    .report-tabs a { padding:7px 16px; border-radius:999px; font-size:13.5px; font-weight:600; color:#4b5563;
                     background:#fff; border:1px solid #e8ebf0; text-decoration:none; }
    .report-tabs a.active, .report-tabs a:hover { background:#0b0b0c; color:#fff; border-color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; overflow:hidden; margin-bottom:18px; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .zx-table td, .zx-table th { vertical-align:middle; }
    .totals-row td { font-weight:600; }
    .btn-pdf { display:inline-flex; align-items:center; gap:7px; background:#0b0b0c; border-color:#0b0b0c; color:#fff; font-weight:600; }
    .btn-pdf:hover { background:#262626; border-color:#262626; color:#fff; }

    /* An uncollected row is listed but is not takings - greyed so nobody
       totals it up by eye. */
    .row-uncollected td { color:#9aa1ad; }

    .num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .amount { font-weight:600; color:#0b0b0c; }
    .src-tag { display:inline-block; padding:2px 9px; border-radius:999px; font-size:11px; font-weight:700;
               text-transform:uppercase; letter-spacing:.3px; }
    .src-sale { background:rgba(59,130,246,.12); color:#1d4ed8; }
    .src-invoice { background:rgba(147,51,234,.12); color:#7e22ce; }
    .breakdown-head { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:15px;
                      padding:14px 18px 0; margin:0; color:#0b0b0c; }
    .breakdown-sub { padding:2px 18px 0; margin:0; color:#7b8290; font-size:12.5px; }
    .breakdown-table td, .breakdown-table th { padding:.6rem .75rem; font-size:13.5px; }
    .breakdown-table tfoot td { border-top:2px solid #e8ebf0; font-weight:700; color:#0b0b0c; }
</style>

<div class="zx-page-head">
    <h1>Collections Report</h1>
</div>

<div class="report-tabs">
    <a asp-action="Index">Overview</a>
    <a asp-action="Sales">Sales</a>
    <a asp-action="JobOrders">Job Orders</a>
    <a asp-action="ServiceInvoices">Service Invoices</a>
    <a asp-action="Quotations">Quotations</a>
    <a asp-action="Collections" class="active">Collections</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Apply</button>
    </div>
    <div class="col-auto">
        <a asp-action="CollectionsPdf" asp-route-from="@from?.ToString("yyyy-MM-dd")"
           asp-route-to="@to?.ToString("yyyy-MM-dd")" class="btn btn-pdf" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h5"/></svg>
            Export PDF
        </a>
    </div>
    <div class="col-auto ms-auto">
        @* The counter's own screen, for acting on a row rather than reading
           a period. The report is the same data over a range. *@
        <a asp-controller="Cashiering" asp-action="Index" class="btn btn-outline-secondary">
            Open Cashiering
        </a>
    </div>
</form>

<div class="zx-card">
    <div class="table-responsive">
        <table class="table zx-table mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Invoice #</th>
                    <th>Date &amp; Time</th>
                    <th>Customer</th>
                    <th>Payment</th>
                    <th>Cashier</th>
                    <th>Status</th>
                    <th class="num pe-3">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in Model.Transactions)
                {
                    <tr class="@(txn.IsCollected ? "" : "row-uncollected")">
                        <td>
                            <span class="src-tag @(txn.Source == CashierSource.Sale ? "src-sale" : "src-invoice")">
                                @(txn.Source == CashierSource.Sale ? "Sale" : "Service")
                            </span>
                        </td>
                        <td>@txn.InvoiceNumber</td>
                        <td>@txn.TransactionDate.ToString("MMM d, yyyy h:mm tt")</td>
                        <td>@(txn.CustomerName ?? "—")</td>
                        <td>@txn.PaymentModeName</td>
                        <td>@(txn.CashierName ?? "—")</td>
                        <td>@txn.Status</td>
                        <td class="num amount pe-3">@("₱" + txn.TotalAmount.ToString("N2"))</td>
                    </tr>
                }
                @if (Model.Transactions.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Nothing was collected in this range.
                        </td>
                    </tr>
                }
                @if (Model.CanSeeTotals && Model.Transactions.Count > 0)
                {
                    <tr class="totals-row">
                        <td colspan="7" class="text-end">Collected</td>
                        <td class="num pe-3">@("₱" + Model.GrandTotal.ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* The same two roll-ups the counter closes a day out with. Admin only,
   matching Cashiering - the controller clears them for anyone else rather
   than trusting this to hide them. *@
@if (Model.CanSeeTotals && (Model.ByPaymentMode.Count > 0 || Model.ByCashier.Count > 0))
{
    <div class="row g-3">
        @if (Model.ByPaymentMode.Count > 0)
        {
            <div class="col-md-6">
                <div class="zx-card h-100">
                    <h2 class="breakdown-head">Collected by Payment Mode</h2>
                    <p class="breakdown-sub">How the money came in. Collected transactions only.</p>
                    <table class="table breakdown-table mb-0">
                        <thead>
                            <tr>
                                <th>Mode</th>
                                <th class="num">Transactions</th>
                                <th class="num pe-3">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mode in Model.ByPaymentMode)
                            {
                                <tr>
                                    <td>@mode.PaymentModeName</td>
                                    <td class="num">@mode.TransactionCount.ToString("N0")</td>
                                    <td class="num amount pe-3">@("₱" + mode.Total.ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.ByPaymentMode.Count > 1)
                        {
                            <tfoot>
                                <tr>
                                    <td>All modes</td>
                                    <td class="num">@modeTransactions.ToString("N0")</td>
                                    <td class="num pe-3">@("₱" + modeTotal.ToString("N2"))</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        }
        @if (Model.ByCashier.Count > 0)
        {
            <div class="col-md-6">
                <div class="zx-card h-100">
                    <h2 class="breakdown-head">Collected by Cashier</h2>
                    <p class="breakdown-sub">Who took it. The same transactions, counted another way.</p>
                    <table class="table breakdown-table mb-0">
                        <thead>
                            <tr>
                                <th>Cashier</th>
                                <th class="num">Transactions</th>
                                <th class="num pe-3">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cashier in Model.ByCashier)
                            {
                                <tr>
                                    <td>@(cashier.CashierName ?? "—")</td>
                                    <td class="num">@cashier.TransactionCount.ToString("N0")</td>
                                    <td class="num amount pe-3">@("₱" + cashier.Total.ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.ByCashier.Count > 1)
                        {
                            <tfoot>
                                <tr>
                                    <td>Everyone</td>
                                    <td class="num">@cashierTransactions.ToString("N0")</td>
                                    <td class="num pe-3">@("₱" + cashierTotal.ToString("N2"))</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        }
    </div>
}
