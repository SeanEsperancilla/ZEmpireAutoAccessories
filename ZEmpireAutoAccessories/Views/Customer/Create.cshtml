@model Customer
@{
    ViewData["Title"] = "Add Customer";
}

@await Html.PartialAsync("_Styles")

<section class="crm-hero">
    <a asp-action="Index" class="back d-inline-flex align-items-center gap-1 mb-2">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to customers
    </a>
    <h1>Add Customer</h1>
    <p>Create a new customer record for your shop.</p>
</section>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
        <div class="crm-panel crm-panel-pad">
            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"
                     style="border-radius:12px;@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

                <div class="crm-field">
                    <label asp-for="FullName">Full name</label>
                    <input asp-for="FullName" class="form-control" autocomplete="off" autofocus placeholder="e.g. Juan Dela Cruz" />
                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                </div>

                <div class="crm-field">
                    <label asp-for="ContactNumber">Contact number <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="ContactNumber" class="form-control" type="tel" inputmode="tel" autocomplete="off" placeholder="e.g. 0917 000 0000" />
                    <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                    <div class="hint">Mobile or landline the customer can be reached at.</div>
                </div>

                <div class="crm-form-actions">
                    <button type="submit" class="btn-zx">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        Add customer
                    </button>
                    <a asp-action="Index" class="btn-outline-zx">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
