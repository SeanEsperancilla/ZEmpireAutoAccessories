@model IEnumerable<ZEmpireAutoAccessories.Models.Customer>

@{
    ViewData["Title"] = "Customers";
    var search = ViewData["Search"] as string;
    var successMessage = TempData["Success"] as string;
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .zx-actions a {
        margin-right: 10px;
        font-weight: 600;
        font-size: 13.5px;
    }
</style>

<div class="zx-page-head">
    <h1>Customers</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Customer</a>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<form asp-action="Index" method="get" class="d-flex gap-2 mb-3" style="max-width:420px;">
    <input type="text" name="q" value="@search" class="form-control" placeholder="Search name or contact number" />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
    @if (!string.IsNullOrEmpty(search))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    }
</form>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.FullName)</th>
                <th>@Html.DisplayNameFor(m => m.ContactNumber)</th>
                <th>Customer Since</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                    <td>@(item.ContactNumber ?? "—")</td>
                    <td>@item.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td class="text-end pe-3 zx-actions">
                        <a asp-action="Edit" asp-route-id="@item.CustomerID">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.CustomerID">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.CustomerID" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(search) ? "No customers yet." : $"No customers match \"{search}\".")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>