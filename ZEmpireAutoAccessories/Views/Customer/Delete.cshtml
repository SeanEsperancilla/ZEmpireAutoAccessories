@model ZEmpireAutoAccessories.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
    var blocked = Model.Vehicles.Count > 0;
    var deleteError = TempData["DeleteError"] as string;
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 18px; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #f3c9cb; border-radius:14px; padding:24px; max-width:560px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
</style>

<div class="zx-page-head">
    <h1>Delete Customer</h1>
</div>

@if (!string.IsNullOrEmpty(deleteError))
{
    <div class="alert alert-danger">@deleteError</div>
}
else if (blocked)
{
    var word = Model.Vehicles.Count == 1 ? "vehicle" : "vehicles";
    <div class="alert alert-danger">
        Can't delete this customer. They still have @Model.Vehicles.Count @word registered.
        Reassign @(Model.Vehicles.Count == 1 ? "it" : "them") to another customer first, then come back and delete.
    </div>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete this customer? This cannot be undone.
    </div>
}

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FullName)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.FullName)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ContactNumber)</dt>
        <dd class="col-sm-8">@(Model.ContactNumber ?? "—")</dd>

        <dt class="col-sm-4">Registered Vehicles</dt>
        <dd class="col-sm-8">@Model.Vehicles.Count</dd>
    </dl>
</div>

@if (blocked)
{
    <div class="zx-card mt-3">
        <h6 class="mb-3">Reassign these vehicles to another customer</h6>
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Plate Number</th>
                    <th>Brand / Model</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td>@(vehicle.PlateNumber ?? "—")</td>
                        <td>@vehicle.Brand @vehicle.Model</td>
                        <td class="text-end pe-3">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Vehicle" asp-action="Edit" asp-route-id="@vehicle.VehicleID">Reassign</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    @if (blocked)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    }
    else
    {
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="CustomerID" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div>
