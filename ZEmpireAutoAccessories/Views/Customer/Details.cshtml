@model ZEmpireAutoAccessories.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; margin-bottom:18px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
</style>

<div class="zx-page-head">
    <h1>Customer Details</h1>
    <a class="btn btn-zx" asp-action="Edit" asp-route-id="@Model.CustomerID">Edit</a>
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ContactNumber)</dt>
        <dd class="col-sm-9">@(Model.ContactNumber ?? "—")</dd>

        <dt class="col-sm-3">Customer Since</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM d, yyyy")</dd>
    </dl>
</div>

<div class="zx-card">
    <h6 class="mb-3">Registered Vehicles (@Model.Vehicles.Count)</h6>
    @if (Model.Vehicles.Count > 0)
    {
        <table class="table zx-table mb-0">
            <thead>
                <tr>
                    <th>Plate Number</th>
                    <th>Brand / Model</th>
                    <th>Year</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td>@(vehicle.PlateNumber ?? "—")</td>
                        <td>@vehicle.Brand @vehicle.Model</td>
                        <td>@(vehicle.ManufacturingYear?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted mb-0">No vehicles registered for this customer.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Index">&larr; Back to list</a>
</div>
