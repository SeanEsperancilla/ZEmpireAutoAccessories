@model ZEmpireAutoAccessories.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2).Select(p => char.ToUpper(p[0])));
}

<style>
    .cust-hero { display:flex; align-items:center; gap:18px; background:#fff; border:1px solid #e8ebf0; border-radius:14px;
                 padding:22px 24px; margin-bottom:22px; }
    .cust-hero-avatar { width:64px; height:64px; border-radius:50%; flex:none; display:grid; place-items:center;
                        font-weight:700; font-size:22px; color:#fff; background:linear-gradient(135deg,var(--zx-red),var(--zx-red2)); }
    .cust-hero h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:21px; margin:0 0 4px; color:#0b0b0c; }
    .cust-hero .meta { color:#7b8290; font-size:13.5px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
    .cust-hero .meta span { display:inline-flex; align-items:center; gap:6px; }
    .cust-hero .meta svg { color:#98a0ad; }
    .cust-hero .actions { margin-left:auto; display:flex; gap:8px; flex:none; }

    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; display:inline-flex; align-items:center; gap:7px; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .btn-outline-danger, .btn-outline-secondary { display:inline-flex; align-items:center; gap:7px; }

    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; margin-bottom:18px; }
    .zx-card-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
    .zx-card h6 { font-weight:700; color:#0b0b0c; margin:0; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .icon-btn { width:32px; height:32px; display:inline-grid; place-items:center; border-radius:8px; border:1px solid #e8ebf0;
                background:#fff; color:#4b5563; transition:all .15s ease; text-decoration:none; }
    .icon-btn:hover { background:#0b0b0c; color:#fff; border-color:#0b0b0c; }

    .back-link { display:inline-flex; align-items:center; gap:6px; color:#4b5563; font-weight:600; font-size:13.5px; text-decoration:none; }
    .back-link:hover { color:#0b0b0c; }
</style>

<div class="cust-hero">
    <span class="cust-hero-avatar">@(string.IsNullOrEmpty(initials) ? "?" : initials)</span>
    <div>
        <h1>@Model.FullName</h1>
        <div class="meta">
            <span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                @(Model.ContactNumber ?? "No contact number")
            </span>
            <span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                Customer since @Model.CreatedAt.ToString("MMM d, yyyy")
            </span>
            <span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
                @Model.Vehicles.Count vehicle@(Model.Vehicles.Count == 1 ? "" : "s")
            </span>
        </div>
    </div>
    <div class="actions">
        <a class="btn btn-zx" asp-action="Edit" asp-route-id="@Model.CustomerID">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            Edit
        </a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.CustomerID">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Delete
        </a>
    </div>
</div>

<div class="zx-card">
    <div class="zx-card-head">
        <h6>Registered Vehicles (@Model.Vehicles.Count)</h6>
        <a class="btn btn-zx btn-sm" asp-controller="Vehicle" asp-action="Create" asp-route-customerId="@Model.CustomerID">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Add Vehicle
        </a>
    </div>
    @if (Model.Vehicles.Count > 0)
    {
        <table class="table zx-table mb-0">
            <thead>
                <tr>
                    <th>Plate Number</th>
                    <th>Brand / Model</th>
                    <th>Year</th>
                    <th>Classification</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td>@(vehicle.PlateNumber ?? "—")</td>
                        <td>@vehicle.Brand @vehicle.Model</td>
                        <td>@(vehicle.ManufacturingYear?.ToString() ?? "—")</td>
                        <td>@vehicle.VehicleClassification.ClassificationName</td>
                        <td class="text-end pe-3">
                            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.VehicleID" class="icon-btn" title="View vehicle">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted mb-0">No vehicles registered for this customer.</p>
    }
</div>

<a asp-action="Index" class="back-link">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    Back to list
</a>
