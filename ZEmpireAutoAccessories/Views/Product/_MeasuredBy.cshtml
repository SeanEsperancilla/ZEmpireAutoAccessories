@*
    How this product is measured: off a roll, or counted in pieces.

    cat.Product has no column for this and nothing may be added to the schema,
    so the choice is stored by MeasureStore in App_Data/product-measures.json
    and posted here as `soldByLength` - empty for "follow the category", which
    is what every product did before this picker existed and stays the default
    so saving an old product changes nothing.

    The category still decides for anything left on "follow", and the script
    keeps that option's label in step with the category dropdown so the
    consequence is visible while the category is being chosen, rather than
    being discovered at the stock screen. The server decides for real, from
    the same list.

    The script sits in the partial body rather than a Scripts section because
    a partial cannot declare one; the category field is rendered above this,
    so the element already exists.
*@
@{
    var lengthCategories = ViewData["LengthCategories"] as HashSet<int> ?? new HashSet<int>();
    var chosen = ViewData["ProductSoldByLength"] as bool?;
}

<div class="mb-3">
    <label class="form-label">Measured by</label>

    <div class="measure-choice">
        <label class="measure-option">
            <span class="measure-option-head">
                <input class="form-check-input mt-0" type="radio" name="soldByLength"
                       value="" checked="@(chosen == null)" />
                Follow the category
            </span>
            <span class="measure-option-help" id="measuredByCategory">
                Pick a category above to see what this means.
            </span>
        </label>

        <label class="measure-option">
            <span class="measure-option-head">
                <input class="form-check-input mt-0" type="radio" name="soldByLength"
                       value="false" checked="@(chosen == false)" />
                Counted in pieces
            </span>
            <span class="measure-option-help">
                Stock is whole units. One line on a job takes one piece off the
                shelf &mdash; use this for a boxed or pre-cut item sitting in a
                film category.
            </span>
        </label>

        <label class="measure-option">
            <span class="measure-option-head">
                <input class="form-check-input mt-0" type="radio" name="soldByLength"
                       value="true" checked="@(chosen == true)" />
                Measured by length
            </span>
            <span class="measure-option-help">
                Roll goods. Stock is kept in centimetres, deliveries and counts
                can be entered in cm, in or m, and a tint job deducts the cut
                size for each panel.
            </span>
        </label>
    </div>
</div>

<script>
    // Categories whose products come off a roll, from UnitOfMeasure on the
    // server. Held as ids so renaming a category cannot put this out of step.
    (function () {
        var LENGTH_CATEGORIES =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lengthCategories));

        var category = document.getElementById('CategoryID');
        var note = document.getElementById('measuredByCategory');
        if (!category || !note) { return; }

        function apply() {
            if (!category.value) {
                note.textContent = 'Pick a category above to see what this means.';
                return;
            }

            var byLength = LENGTH_CATEGORIES.indexOf(parseInt(category.value, 10)) !== -1;
            var name = category.options[category.selectedIndex].text;

            note.textContent = byLength
                ? '“' + name + '” is measured by length, so this product will be too.'
                : '“' + name + '” is counted in pieces, so this product will be too.';
        }

        category.addEventListener('change', apply);
        apply();
    })();
</script>
