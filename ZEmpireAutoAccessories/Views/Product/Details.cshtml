@model ZEmpireAutoAccessories.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<style>
    .prod-hero {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 22px 24px;
        margin-bottom: 22px;
    }

    .prod-hero-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        flex: none;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg,#fde8e9,#fbd3d5);
        color: #c0202a;
    }

    .prod-hero h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 21px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .prod-hero .meta {
        color: #7b8290;
        font-size: 13.5px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .prod-hero .actions {
        margin-left: auto;
        display: flex;
        gap: 8px;
        flex: none;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 22px;
    }

    dt {
        color: #7b8290;
        font-weight: 600;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    dd {
        margin-bottom: 14px;
        font-size: 15px;
        color: #0b0b0c;
    }

    .badge-active {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-inactive {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #4b5563;
        font-weight: 600;
        font-size: 13.5px;
        text-decoration: none;
        margin-top: 16px;
    }

        .back-link:hover {
            color: #0b0b0c;
        }
</style>

<div class="prod-hero">
    <span class="prod-hero-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.5 4.21" /><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><path d="M3.27 6.96 12 12.01l8.73-5.05" /><path d="M12 22.08V12" /></svg>
    </span>
    <div>
        <h1>@Model.ProductName</h1>
        <div class="meta">
            <span>@Model.Category.CategoryName</span>
            <span>@(Model.DefaultPrice.HasValue ? Model.DefaultPrice.Value.ToString("C") : "No default price")</span>
            @if (Model.IsActive)
            {
                <span class="badge badge-active">Active</span>
            }
            else
            {
                <span class="badge badge-inactive">Inactive</span>
            }
        </div>
    </div>
    <div class="actions">
        <a class="btn btn-zx" asp-action="Edit" asp-route-id="@Model.ProductID">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
            Edit
        </a>
    </div>
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ProductName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ProductName)</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category.CategoryName</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
        <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DefaultPrice)</dt>
        <dd class="col-sm-9">@(Model.DefaultPrice.HasValue ? Model.DefaultPrice.Value.ToString("C") : "—")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsActive)</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>

        <dt class="col-sm-3">Pricing entries</dt>
        <dd class="col-sm-9">@Model.Pricings.Count</dd>
    </dl>
</div>

<a asp-action="Index" class="back-link">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
    Back to list
</a>