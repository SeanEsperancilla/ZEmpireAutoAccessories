@model IEnumerable<ZEmpireAutoAccessories.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; overflow:hidden; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .zx-table td, .zx-table th { vertical-align:middle; }
    .zx-actions a { margin-right:10px; font-weight:600; font-size:13.5px; }
    .badge-active { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-inactive { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
</style>

<div class="zx-page-head">
    <h1>Products</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Product</a>
</div>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.ProductName)</th>
                <th>Category</th>
                <th>Default Price</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td>@item.Category.CategoryName</td>
                    <td>@(item.DefaultPrice.HasValue ? item.DefaultPrice.Value.ToString("C") : "—")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td class="text-end pe-3 zx-actions">
                        <a asp-action="Edit" asp-route-id="@item.ProductID">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.ProductID">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductID" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No products yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
