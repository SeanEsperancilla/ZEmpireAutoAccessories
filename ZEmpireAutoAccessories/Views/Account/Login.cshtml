@model ZEmpireAutoAccessories.Models.Account.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <aside class="auth-brand">
        <div class="brand-logo">
            <img src="~/images/ZEmpireLogo.png" alt="Z-Empire Auto Accessories" />
            <span class="wm">Z<b>-</b>EMPIRE</span>
        </div>

        <div class="brand-copy">
            <h1>Automotive <span>Management</span> System</h1>
            <p>Job orders, quotations, inventory and invoicing — one control room for the shop.</p>
            <ul class="brand-points">
                <li>
                    <span class="tick"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                    Role-based access for Admin, Manager &amp; Staff
                </li>
                <li>
                    <span class="tick"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                    Quotation to job order in one click
                </li>
                <li>
                    <span class="tick"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                    Live stock &amp; sales reporting
                </li>
            </ul>
        </div>

        <div class="brand-foot">EST. 2020 · ZEMPIRE AUTO ACCESSORIES SHOP</div>
    </aside>

    <section class="auth-form">
        <div class="form-logo">
            <img src="~/images/ZEmpireLogo.png" alt="Z-Empire" />
        </div>

        <h2>Sign in</h2>
        <p class="sub">Welcome back — access your dashboard.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger val-summary" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

            <div class="field">
                <label asp-for="UserNameOrEmail"></label>
                <div class="input-wrap">
                    <svg class="lead" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" autofocus placeholder="Username" />
                </div>
                <span asp-validation-for="UserNameOrEmail" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <div class="input-wrap">
                    <svg class="lead" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <input asp-for="Password" type="password" id="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    <button type="button" class="toggle-pass" id="togglePass" aria-label="Show password">
                        <svg id="eye" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="row-between">
                <label class="remember">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Remember me</span>
                </label>
            </div>

            <button type="submit" class="btn-signin">Sign in</button>

            <div class="form-foot">Protected area · authorized personnel only</div>
        </form>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById('togglePass');
            var pass = document.getElementById('Password');
            if (btn && pass) {
                btn.addEventListener('click', function () {
                    var show = pass.type === 'password';
                    pass.type = show ? 'text' : 'password';
                    document.getElementById('eye').style.opacity = show ? '0.55' : '1';
                });
            }
        })();
    </script>
}
