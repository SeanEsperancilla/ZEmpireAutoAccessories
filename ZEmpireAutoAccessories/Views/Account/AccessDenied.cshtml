@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access denied";
}

<div class="auth-card" style="max-width:520px;grid-template-columns:1fr;">
    <section class="auth-form" style="text-align:center;align-items:center;">
        <img src="~/images/ZEmpireLogo.png" alt="Z-Empire" style="width:64px;height:64px;margin-bottom:16px;opacity:.9;" />
        <div style="width:70px;height:70px;border-radius:18px;display:grid;place-items:center;margin-bottom:16px;
                    background:linear-gradient(135deg,rgba(229,70,77,.18),rgba(176,24,34,.28));color:#ff8a8f;border:1px solid rgba(229,70,77,.4);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
        </div>
        <h2>Access denied</h2>
        <p class="sub">You don't have permission to open this module. If you think this is a mistake, contact your administrator.</p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a class="btn-signin" asp-controller="Home" asp-action="Index"
               style="width:auto;padding:0 22px;height:44px;display:inline-flex;align-items:center;text-decoration:none;">Back to dashboard</a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                <button type="submit" class="btn" style="height:44px;padding:0 20px;border-radius:12px;border:1px solid var(--zx-line);background:transparent;color:#cfd6e2;">Sign out</button>
            </form>
        </div>
    </section>
</div>
