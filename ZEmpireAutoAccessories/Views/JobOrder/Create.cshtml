@model ZEmpireAutoAccessories.Models.JobOrder

@{
    ViewData["Title"] = "New Job Order";
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 18px;
        color: #0b0b0c;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 720px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }
</style>

<div class="zx-page-head">
    <h1>New Job Order</h1>
</div>

<div class="zx-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerID" class="form-label"></label>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleID" class="form-label"></label>
                <select asp-for="VehicleID" class="form-select" asp-items="ViewBag.VehicleID">
                    <option value="">-- Select Vehicle --</option>
                </select>
                <span asp-validation-for="VehicleID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="JobTypeID" class="form-label">Job Type <span class="text-muted fw-normal">(optional)</span></label>
                <select asp-for="JobTypeID" class="form-select" asp-items="ViewBag.JobTypeID">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AssignedEmployeeID" class="form-label">Assigned Employee <span class="text-muted fw-normal">(optional)</span></label>
                <select asp-for="AssignedEmployeeID" class="form-select" asp-items="ViewBag.AssignedEmployeeID">
                    <option value="">-- Unassigned --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="InstallationDate" class="form-label">Installation Date <span class="text-muted fw-normal">(optional)</span></label>
                <input asp-for="InstallationDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Odometer" class="form-label">Odometer <span class="text-muted fw-normal">(optional)</span></label>
                <input asp-for="Odometer" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ExistingFilmShade" class="form-label"></label>
            <input asp-for="ExistingFilmShade" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ReasonForChanging" class="form-label"></label>
            <textarea asp-for="ReasonForChanging" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Complaint" class="form-label"></label>
            <textarea asp-for="Complaint" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="SpecialInstruction" class="form-label"></label>
            <textarea asp-for="SpecialInstruction" class="form-control" rows="2"></textarea>
        </div>

        <button type="submit" class="btn btn-zx">Save &amp; Add Line Items</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>