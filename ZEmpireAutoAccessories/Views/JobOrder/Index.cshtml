@model IEnumerable<ZEmpireAutoAccessories.Models.JobOrder>

@{
    ViewData["Title"] = "Job Orders";
    var status = ViewData["Status"] as string;
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .icon-btn {
        width: 32px;
        height: 32px;
        display: inline-grid;
        place-items: center;
        border-radius: 8px;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        margin-left: 6px;
        transition: all .15s ease;
        text-decoration: none;
    }

        .icon-btn:hover {
            background: #0b0b0c;
            color: #fff;
            border-color: #0b0b0c;
        }

        .icon-btn.danger:hover {
            background: #dc2626;
            color: #fff;
            border-color: #dc2626;
        }

    .badge-pending {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }

    .badge-inprogress {
        background: rgba(59,130,246,.15);
        color: #1d4ed8;
        font-weight: 600;
    }

    .badge-completed {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-cancelled {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .status-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .status-pill {
        padding: 7px 16px;
        border-radius: 999px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #e8ebf0;
        background: #fff;
        color: #4b5563;
        transition: all .15s ease;
    }

        .status-pill:hover {
            border-color: #c7ccd6;
            color: #0b0b0c;
        }

        .status-pill.active {
            color: #fff;
            border-color: transparent;
        }

        .status-pill.all.active {
            background: #0b0b0c;
        }

        .status-pill.status-pending.active {
            background: #64748b;
        }

        .status-pill.status-inprogress.active {
            background: #2563eb;
        }

        .status-pill.status-completed.active {
            background: #16a34a;
        }

        .status-pill.status-cancelled.active {
            background: #dc2626;
        }
</style>

<div class="zx-page-head">
    <h1>Job Orders</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Job Order</a>
</div>

<div class="status-filters">
    <a asp-action="Index" class="status-pill all @(status == null ? "active" : "")">All</a>
    <a asp-action="Index" asp-route-status="Pending" class="status-pill status-pending @(status == "Pending" ? "active" : "")">Pending</a>
    <a asp-action="Index" asp-route-status="In Progress" class="status-pill status-inprogress @(status == "In Progress" ? "active" : "")">In Progress</a>
    <a asp-action="Index" asp-route-status="Completed" class="status-pill status-completed @(status == "Completed" ? "active" : "")">Completed</a>
    <a asp-action="Index" asp-route-status="Cancelled" class="status-pill status-cancelled @(status == "Cancelled" ? "active" : "")">Cancelled</a>
</div>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Number</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Assigned To</th>
                <th>Date</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.JobOrderNumber</td>
                    <td>@item.Customer.FullName</td>
                    <td>@(item.Vehicle.PlateNumber ?? "—")</td>
                    <td>@(item.AssignedEmployee != null ? $"{item.AssignedEmployee.FirstName} {item.AssignedEmployee.LastName}" : "—")</td>
                    <td>@item.JobOrderDate.ToString("MMM d, yyyy")</td>
                    <td><span class="badge badge-@item.Status.ToLower().Replace(" ", "")">@item.Status</span></td>
                    <td class="text-end pe-3">
                        <a asp-action="Details" asp-route-id="@item.JobOrderID" class="icon-btn" title="View details">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.JobOrderID" class="icon-btn" title="Edit">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.JobOrderID" class="icon-btn danger" title="Delete">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No job orders yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>