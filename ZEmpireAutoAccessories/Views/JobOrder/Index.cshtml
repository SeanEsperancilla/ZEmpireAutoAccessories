@model IEnumerable<ZEmpireAutoAccessories.Models.JobOrder>

@{
    ViewData["Title"] = "Job Orders";
    var status = ViewData["Status"] as string;
}

<style>
    .zx-page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .zx-page-head h1 {
            font-family: 'Oswald',system-ui,sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin: 0;
            color: #0b0b0c;
        }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        overflow: hidden;
    }

    .zx-table thead {
        background: #0b0b0c;
        color: #fff;
    }

        .zx-table thead th {
            border-bottom: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .zx-table td, .zx-table th {
        vertical-align: middle;
    }

    .zx-actions a {
        margin-right: 10px;
        font-weight: 600;
        font-size: 13.5px;
    }

    .badge-pending {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }

    .badge-inprogress {
        background: rgba(59,130,246,.15);
        color: #1d4ed8;
        font-weight: 600;
    }

    .badge-completed {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-cancelled {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }

    .status-filters a {
        margin-right: 8px;
        font-size: 13px;
    }
</style>

<div class="zx-page-head">
    <h1>Job Orders</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Job Order</a>
</div>

<div class="status-filters mb-3">
    <a asp-action="Index" class="@(status == null ? "fw-bold" : "")">All</a>
    <a asp-action="Index" asp-route-status="Pending" class="@(status == "Pending" ? "fw-bold" : "")">Pending</a>
    <a asp-action="Index" asp-route-status="In Progress" class="@(status == "In Progress" ? "fw-bold" : "")">In Progress</a>
    <a asp-action="Index" asp-route-status="Completed" class="@(status == "Completed" ? "fw-bold" : "")">Completed</a>
    <a asp-action="Index" asp-route-status="Cancelled" class="@(status == "Cancelled" ? "fw-bold" : "")">Cancelled</a>
</div>

<div class="zx-card">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Number</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Assigned To</th>
                <th>Date</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.JobOrderNumber</td>
                    <td>@item.Customer.FullName</td>
                    <td>@(item.Vehicle.PlateNumber ?? "—")</td>
                    <td>@(item.AssignedEmployee != null ? $"{item.AssignedEmployee.FirstName} {item.AssignedEmployee.LastName}" : "—")</td>
                    <td>@item.JobOrderDate.ToString("MMM d, yyyy")</td>
                    <td><span class="badge badge-@item.Status.ToLower().Replace(" ", "")">@item.Status</span></td>
                    <td class="text-end pe-3 zx-actions">
                        <a asp-action="Details" asp-route-id="@item.JobOrderID">View</a>
                        <a asp-action="Edit" asp-route-id="@item.JobOrderID">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.JobOrderID" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No job orders yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>