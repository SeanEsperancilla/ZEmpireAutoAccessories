@model ZEmpireAutoAccessories.Models.JobOrder

@{
    ViewData["Title"] = "Job Order Details";
    var total = Model.Details.Sum(d => d.SubTotal);
    var successMessage = TempData["Success"] as string;
    var lockError = TempData["LockError"] as string;
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; margin-bottom:18px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .badge-pending { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
    .badge-inprogress { background:rgba(59,130,246,.15); color:#1d4ed8; font-weight:600; }
    .badge-completed { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-cancelled { background:rgba(239,68,68,.15); color:#b91c1c; font-weight:600; }
    .badge-posted { background:rgba(124,58,237,.15); color:#6d28d9; font-weight:600; }
    .btn-post { background:#7c3aed; border-color:#7c3aed; color:#fff; }
    .btn-post:hover { background:#6d28d9; border-color:#6d28d9; color:#fff; }
    .totals-row td { font-weight:600; }
    .status-actions form { display:inline; margin-right:8px; }
    .btn-zx, .btn-outline-secondary { display:inline-flex; align-items:center; gap:7px; }
    .btn-pdf { display:inline-flex; align-items:center; gap:7px; background:#0b0b0c; border-color:#0b0b0c; color:#fff; font-weight:600; }
    .btn-pdf:hover { background:#262626; border-color:#262626; color:#fff; }
</style>

<div class="zx-page-head">
    <h1>Job Order @Model.JobOrderNumber</h1>
    <div>
        @if (Model.Status != "Posted")
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.JobOrderID">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit
            </a>
        }
        <a class="btn btn-pdf" asp-action="Pdf" asp-route-id="@Model.JobOrderID" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            Generate PDF
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Back to list
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(lockError))
{
    <div class="alert alert-danger">@lockError</div>
}

<div class="zx-card">
    <dl class="row mb-3">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.Customer.FullName</dd>

        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">@(Model.Vehicle.PlateNumber ?? "—") — @Model.Vehicle.Brand @Model.Vehicle.Model</dd>

        <dt class="col-sm-3">Job Type</dt>
        <dd class="col-sm-9">@(Model.JobType?.JobTypeName ?? "—")</dd>

        <dt class="col-sm-3">Assigned Employee</dt>
        <dd class="col-sm-9">@(Model.AssignedEmployee != null ? $"{Model.AssignedEmployee.FirstName} {Model.AssignedEmployee.LastName}" : "Unassigned")</dd>

        <dt class="col-sm-3">Job Order Date</dt>
        <dd class="col-sm-9">@Model.JobOrderDate.ToString("MMM d, yyyy")</dd>

        <dt class="col-sm-3">Installation Date</dt>
        <dd class="col-sm-9">@(Model.InstallationDate?.ToString("MMM d, yyyy") ?? "—")</dd>

        <dt class="col-sm-3">Odometer</dt>
        <dd class="col-sm-9">@(Model.Odometer?.ToString() ?? "—")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><span class="badge badge-@Model.Status.ToLower().Replace(" ", "")">@Model.Status</span></dd>

        @if (Model.Quotation != null)
        {
            <dt class="col-sm-3">From Quotation</dt>
            <dd class="col-sm-9">@Model.Quotation.QuotationNumber</dd>
        }

        @if (!string.IsNullOrEmpty(Model.ExistingFilmShade))
        {
            <dt class="col-sm-3">Existing Film Shade</dt>
            <dd class="col-sm-9">@Model.ExistingFilmShade</dd>
        }

        @if (!string.IsNullOrEmpty(Model.ReasonForChanging))
        {
            <dt class="col-sm-3">Reason for Changing</dt>
            <dd class="col-sm-9">@Model.ReasonForChanging</dd>
        }

        @if (!string.IsNullOrEmpty(Model.Complaint))
        {
            <dt class="col-sm-3">Complaint</dt>
            <dd class="col-sm-9">@Model.Complaint</dd>
        }

        @if (!string.IsNullOrEmpty(Model.SpecialInstruction))
        {
            <dt class="col-sm-3">Special Instruction</dt>
            <dd class="col-sm-9">@Model.SpecialInstruction</dd>
        }
    </dl>

    <div class="status-actions">
        @if (Model.Status == "Pending")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.JobOrderID" />
                <input type="hidden" name="status" value="In Progress" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Start Job</button>
            </form>
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.JobOrderID" />
                <input type="hidden" name="status" value="Cancelled" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel Job</button>
            </form>
        }
        @if (Model.Status == "In Progress")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.JobOrderID" />
                <input type="hidden" name="status" value="Completed" />
                <button type="submit" class="btn btn-sm btn-zx">Mark Completed</button>
            </form>
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.JobOrderID" />
                <input type="hidden" name="status" value="Cancelled" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel Job</button>
            </form>
        }
        @if (Model.Status == "Completed")
        {
            <a asp-action="Post" asp-route-id="@Model.JobOrderID" class="btn btn-sm btn-post">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Post &amp; Lock
            </a>
        }
        @if (Model.Status == "Posted")
        {
            <span class="text-muted small">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                This job order is posted and locked from further edits.
            </span>
        }
    </div>
</div>

<div class="zx-card">
    <h6 class="mb-3">Line Items</h6>
    <table class="table zx-table mb-3">
        <thead>
            <tr>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Sub Total</th>
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Details)
            {
                <tr>
                    <td>
                        @(line.Product?.ProductName ?? line.Service?.ServiceName ?? "—")
                        @if (!string.IsNullOrEmpty(line.Description))
                        {
                            <div class="text-muted small">@line.Description</div>
                        }
                    </td>
                    <td>@line.Quantity</td>
                    <td>@line.Unit</td>
                    <td>@("₱" + line.UnitPrice.ToString("N2"))</td>
                    <td>@("₱" + line.SubTotal.ToString("N2"))</td>
                    <td class="text-end pe-3">
                        @if (Model.Status != "Posted")
                        {
                            <form asp-action="RemoveLine" method="post" class="d-inline"
                                  onsubmit="return confirm('Remove this line item?');">
                                <input type="hidden" name="detailId" value="@line.JobOrderDetailID" />
                                <input type="hidden" name="jobOrderId" value="@Model.JobOrderID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Details.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">No line items yet.</td>
                </tr>
            }
            <tr class="totals-row">
                <td colspan="4" class="text-end">Total</td>
                <td colspan="2">@("₱" + total.ToString("N2"))</td>
            </tr>
        </tbody>
    </table>

    @if (Model.Status != "Posted")
    {
        <h6 class="mb-3">Add Line Item</h6>
        <form asp-action="AddLine" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="jobOrderId" value="@Model.JobOrderID" />

            <div class="col-md-3">
                <label class="form-label">Product</label>
                <select name="productId" class="form-select" asp-items="ViewBag.ProductID">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Service</label>
                <select name="serviceId" class="form-select" asp-items="ViewBag.ServiceID">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Description</label>
                <input type="text" name="description" class="form-control" placeholder="Optional" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Qty</label>
                <input type="number" name="quantity" class="form-control" value="1" min="1" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Unit</label>
                <input type="text" name="unit" class="form-control" value="Unit" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Price</label>
                <input type="number" step="0.01" name="unitPrice" class="form-control" value="0" min="0" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-zx w-100">Add</button>
            </div>
        </form>
        <div class="form-text mt-2">Pick either a Product or a Service for the line item.</div>
    }
</div>
