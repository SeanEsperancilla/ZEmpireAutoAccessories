  {
    "ConnectionStrings": {
      "DefaultConnection": "Server=.;Database=ZEmpire;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Product categories measured off a roll: stock held in centimetres and
  // entered in cm, in or m. Every other category is counted in whole pieces.
  // Add a category name here when you create a new film category - no code
  // change and no database change. Restart the app to pick it up.
  // Remove the section entirely to fall back to the built-in list.
  "Inventory": {
    "LengthCategories": [
      "Paint Protection Film",
      "Paint Protection",
      "Window Tint",
      "Tint"
    ]
  },

  // Categories that are two names for the same shelf. The left name is
  // shown and grouped as the right one, and is kept off the Product form so
  // nothing new is filed under it. Nothing in the database is changed.
  "Catalog": {
    "EquivalentCategories": {
      "Paint Protection": "Paint Protection Film",
      "Tint": "Window Tint"
    }
  },

  // How the shop takes money. "Modes" is what the forms offer, in this
  // order; a name that is not in sales.PaymentMode yet is added there at
  // startup. A mode left off this list is not offered any more but is never
  // deleted - old transactions still point at it.
  //
  // "ModesNeedingProof" are the ones that arrive from somewhere other than
  // the counter, so Cashiering asks for the receipt and flags the rows that
  // have none. "ProofFolder" is where those files are kept: relative to the
  // app folder unless it starts with a drive or a slash, and deliberately
  // outside wwwroot so the receipts are not readable over the web.
  //
  // "RenamedModes" is old name -> new name. The row is renamed in place, so
  // every transaction already pointing at it keeps pointing at it and simply
  // reads differently - which is what makes this safe where adding the new
  // name and retiring the old one would leave two rows meaning one thing.
  "Payments": {
    "Modes": [ "Bank Transfers", "Credit Cards", "GCash", "Cash" ],
    "RenamedModes": {
      "Bank Transfer": "Bank Transfers",
      "Card": "Credit Cards"
    },
    "ModesNeedingProof": [ "Bank Transfers", "Bank Transfer", "GCash", "QRPH" ],
    "ProofFolder": "App_Data/payment-proofs",
    "MaxProofBytes": 5242880
  },

  "AllowedHosts": "*"
}